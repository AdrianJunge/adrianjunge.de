#!/usr/bin/env ruby
APP_ROOT = File.expand_path("..", __dir__)

Dir.chdir(APP_ROOT) do
  required_ruby = File.read(".ruby-version").strip
  abort "Activate Ruby #{required_ruby} before running bin/dev (active: #{RUBY_VERSION})." unless RUBY_VERSION == required_ruby

  # Puma's development-only Tailwind plugin owns the watcher and its lifecycle.
  # Build once so the first request never races the initial watcher compilation.
  system("bin/rails", "tailwindcss:build", exception: true)
  exec "bin/rails", "server", *ARGV
end
