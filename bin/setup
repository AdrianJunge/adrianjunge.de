#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

Dir.chdir(APP_ROOT) do
  if (ARGV - [ "--skip-server" ]).any?
    abort "Usage: bin/setup [--skip-server]"
  end

  required_ruby = File.read(".ruby-version").strip
  abort "Activate Ruby #{required_ruby} before running bin/setup (active: #{RUBY_VERSION})." unless RUBY_VERSION == required_ruby
  abort "Install Node 24 LTS and npm for development checks." unless system("node", "-e", "process.exit(Number(process.versions.node.split('.')[0]) >= 24 ? 0 : 1)")

  puts "Installing locked dependencies"
  system({ "BUNDLE_FROZEN" => "true" }, "bundle", "install", exception: true)
  system("npm", "ci", exception: true)
  system("bin/rails", "db:prepare", "tailwindcss:build", exception: true)

  unless ARGV.include?("--skip-server")
    STDOUT.flush
    exec "bin/dev"
  end
end
