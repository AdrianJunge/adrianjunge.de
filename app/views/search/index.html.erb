<% search_description = "Global search across CVEs, bug bounties, certificates, achievements, CTF writeups, and blog posts." %>

<% content_for :head do %>
  <%= seo_meta_tags(
        title: "Global Search",
        description: search_description,
        canonical_path: search_path,
        json_ld: seo_collection_schema(title: "Global Search", description: search_description, canonical_path: search_path)
      ) %>
<% end %>

<%= render_taskbar_items %>
<%= render_terminal([], true) %>

<main class="content-page search-page">
  <%= render "shared/content_hero",
             icon_path: "task-bar/search.svg",
             icon_alt: "Global Search",
             title: "Global Search",
             description: search_description %>

  <%= render "shared/content_filters",
             scope: "global-search",
             years: @filter_years,
             tags: @filter_tags,
             tag_groups: @filter_tag_groups,
             total: @search_items.length,
             search_id: "global-search-input",
             clear_id: "global-search-clear",
             search_value: @initial_query,
             placeholder: "Search writeups, CVEs, tools, certificates...",
             tag_label: "Filters" %>

  <div class="search-results-container">
    <% @search_items.each do |item| %>
      <article
        class="search-result-entry"
        data-filter-card="global-search"
        data-filter-text="<%= item[:search_text] %>"
        data-filter-years="<%= item[:published].year %>"
        data-filter-tags="<%= item[:tags].join("|") %>"
      >
        <a href="<%= item[:link] %>" class="search-result-card ui-hover-lift" aria-label="Open <%= item[:title] %>">
          <span class="search-result-kind"><%= item[:label] %></span>

          <span class="search-result-main">
            <span class="search-result-title"><%= item[:title] %></span>
            <% if item[:description].present? %>
              <span class="search-result-description"><%= truncate(item[:description], length: 190) %></span>
            <% end %>
          </span>

          <span class="search-result-footer">
            <span class="search-result-source"><%= item[:source] %></span>
            <time datetime="<%= item[:published].iso8601 %>"><%= item[:display_date] %></time>
          </span>

          <% if item[:tags].any? %>
            <span class="search-result-tags">
              <% item[:tags].first(6).each do |tag_name| %>
                <span class="ui-tag-pill text-white bg-slate-700"><%= tag_name %></span>
              <% end %>
            </span>
          <% end %>
        </a>
      </article>
    <% end %>
  </div>

  <div class="content-filter-empty" data-filter-empty="global-search" hidden>
    <p>No indexed content matches the current filters.</p>
  </div>
</main>
