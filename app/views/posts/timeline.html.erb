<% timeline_description = "Security research, CTF writeups, blog posts, CVEs, bug bounties, authored challenges, certificates, talks, and achievements ordered by date." %>

<% content_for :head do %>
  <%= seo_meta_tags(
        title: "Timeline",
        description: timeline_description,
        canonical_path: timeline_path,
        json_ld: seo_collection_schema(
          title: "Timeline",
          description: timeline_description,
          canonical_path: timeline_path,
          items: @timeline_items
        ),
        breadcrumbs: [
          { title: "Home", link: root_path },
          { title: "Timeline", link: timeline_path }
        ]
      ) %>
<% end %>

<%= render_taskbar_items %>
<%= render_terminal([], true) %>

<main class="content-page timeline-page">
  <%= render "shared/content_hero",
             icon_path: "task-bar/timeline.svg",
             icon_alt: "Timeline",
             title: "Timeline",
             description: timeline_description %>

  <%= render "shared/content_filters",
             scope: "timeline",
             years: @filter_years,
             tags: @filter_tags,
             tag_groups: @filter_tag_groups,
             total: @timeline_items.length,
             search_id: "timeline-search-input",
             clear_id: "timeline-search-clear",
             search_value: @initial_query,
             placeholder: "Search writeups, blog posts, CVEs, talks, achievements...",
             tag_label: "Filters" %>

  <div class="timeline-shell" data-filter-results="timeline">
    <ul class="timeline">
      <% @timeline.each do |year, items| %>
        <li class="timeline-year-group" data-filter-group="timeline">
          <div class="timeline-year-header">
            <h2><%= year %></h2>
            <span class="timeline-year-count" data-filter-group-count="timeline">
              <%= items.size %> <%= items.size == 1 ? "item" : "items" %>
            </span>
          </div>

          <ul class="timeline-year-items">
            <% items.each do |item| %>
              <% item_upcoming = upcoming_date?(item[:published]) %>
              <% timeline_content_type_tags = Array(item[:kind_labels]).map { |kind_label| kind_label[:tag_value].presence || kind_label[:label] } %>
              <% visible_tags = item[:tags].reject { |tag_name| [ WriteupWinner::FILTER_LABEL, AuthoredChallenge::FILTER_LABEL ].include?(tag_name) || timeline_content_type_tags.include?(tag_name) } %>
              <li
                class="<%= class_names("timeline-item", "timeline-item-upcoming": item_upcoming) %>"
                data-filter-card="timeline"
                data-filter-text="<%= [ ("Upcoming" if item_upcoming), item[:title], item[:description], item[:source], item[:label], item[:display_date] ].compact.join(" ") %>"
                data-filter-years="<%= item[:published].year %>"
                data-filter-tags="<%= item[:tags].join("|") %>"
                data-upcoming="<%= item_upcoming %>"
              >
                <div class="timeline-date">
                  <span class="timeline-date-heading">
                    <time datetime="<%= item[:published].iso8601 %>">
                      <%= item[:display_date] %>
                    </time>
                  </span>
                  <% if item_upcoming || Array(item[:kind_labels]).any? %>
                    <span class="timeline-side-tags">
                      <%= content_upcoming_badge(class_name: "timeline-upcoming-badge") if item_upcoming %>
                      <% Array(item[:kind_labels]).each do |kind_label| %>
                        <%= content_filter_chip(
                              kind_label[:label],
                              scope: "timeline",
                              tag_value: kind_label[:tag_value].presence || kind_label[:label],
                              class_name: "timeline-kind-pill"
                            ) %>
                      <% end %>
                    </span>
                  <% end %>
                </div>

                <div class="timeline-connector">
                  <div class="dot"></div>
                </div>

                <% timeline_tags = [] %>
                <% if item[:writeup_winner].present? %>
                  <% timeline_tags << {
                       label: item[:writeup_winner][:label],
                       tag_value: WriteupWinner::FILTER_LABEL,
                       winner: true,
                       class_name: "writeup-winner-badge-timeline",
                       title: item[:writeup_winner][:label]
                     } %>
                <% end %>
                <% if item[:authored_challenge].present? %>
                  <% timeline_tags << {
                       label: item[:authored_challenge][:label],
                       tag_value: AuthoredChallenge::FILTER_LABEL,
                       authored: true,
                       class_name: "authored-challenge-badge-timeline",
                       title: AuthoredChallenge::FILTER_LABEL
                     } %>
                <% end %>
                <% visible_tags.first(6).each do |tag_name| %>
                  <% if WriteupDifficulty.filter_label?(tag_name) %>
                    <% timeline_tags << {
                         label: tag_name,
                         class_name: "timeline-tag-pill",
                         difficulty_filter: true,
                         difficulty_key: tag_name
                       } %>
                  <% elsif ContentCategoryTag.recognized?(tag_name) %>
                    <% timeline_tags << {
                         label: tag_name,
                         class_name: "timeline-tag-pill",
                         category: true,
                         category_key: tag_name
                       } %>
                  <% elsif ContentSeverityTag.recognized?(tag_name) %>
                    <% timeline_tags << {
                         label: tag_name,
                         class_name: "timeline-tag-pill",
                         severity: true,
                         severity_key: tag_name
                       } %>
                  <% else %>
                    <% timeline_tags << { label: tag_name, class_name: "timeline-tag-pill" } %>
                  <% end %>
                <% end %>
                <% timeline_media = nil %>
                <% timeline_media_html = nil %>
                <% timeline_icon = item[:logo].presence || case item[:kind]
                   when "blog" then "task-bar/blog.svg"
                   when "cve" then "other/cve.svg"
                   when "bug-bounty" then "other/bug-bounty.svg"
                   when "certificate" then "other/certificate.svg"
                   when "talk" then "other/talk-slides.png"
                   when "achievement" then "other/achievement.svg"
                   else "other/achievement.svg"
                   end %>
                <% if item[:kind] == "writeup" && item[:logo].blank? %>
                  <% timeline_categories = item[:tags].select { |tag_name| ContentCategoryTag.recognized?(tag_name) } %>
                  <% timeline_media_html = get_category_icon(timeline_categories.presence || [ "Unknown category" ]).html_safe %>
                  <% timeline_media = {
                       wrapper_class: "blog-post-card-logo writeup-post-card-logo timeline-card-logo"
                     } %>
                <% else %>
                  <% timeline_media = {
                       image: timeline_icon,
                       alt: "#{item[:title]} icon",
                       image_class: "blog-logo",
                       wrapper_class: [ "blog-post-card-logo", ("writeup-post-card-logo" if item[:kind] == "writeup"), "timeline-card-logo" ].compact.join(" ")
                     } %>
                <% end %>
                <% timeline_has_media = timeline_media.present? || timeline_media_html.present? %>
                <% timeline_section_link = case item[:kind]
                   when "blog"
                     { url: blog_path, icon: "task-bar/blog.svg", kind: "blog", label: "Browse blog posts" }
                   when "writeup"
                     { url: ctf_path, icon: "task-bar/flag.svg", kind: "ctf", label: "Browse CTF writeups" }
                   end %>

                <%= render_content_card(
                      url: item[:link],
                      class_name: [ "timeline-content", ("timeline-content-with-media" if timeline_has_media) ].compact.join(" "),
                      content_class: "blog-post-card-content timeline-card-content",
                      body_class: "blog-post-card-details timeline-card-details",
                      media_html: timeline_media_html,
                      media: timeline_media,
                      wrap_content: timeline_has_media,
                      wrap_body: timeline_has_media,
                      hitbox_class: "timeline-card-hitbox",
                      title: item[:title],
                      title_tag: :span,
                      title_class: "timeline-title",
                      tags: timeline_tags,
                      tags_class: "timeline-tags",
                      filter_scope: "timeline",
                      description: item[:description],
                      description_class: "timeline-meta",
                      reading_time: item[:reading_time_label],
                      reading_time_class: "timeline-reading-time",
                      section_link: timeline_section_link,
                      aria_label: "Open #{item[:title]}"
                    ) %>
              </li>
            <% end %>
          </ul>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="content-filter-empty" data-filter-empty="timeline" hidden>
    <p>No indexed content matches the current filters.</p>
  </div>
</main>
