<% content_for :head do %>
  <title>Posts timeline</title>
  <meta name="description" content="A timeline of all posts and writeups organized by year.">
  <meta property="og:title" content="Posts timeline">
  <meta property="og:description" content="A timeline of all posts and writeups organized by year.">
  <meta property="og:type" content="website">
<% end %>

<%= render_taskbar_items %>
<%= render_terminal([], true) %>

<main class="content-page timeline-page">
<%= render "shared/content_hero",
           icon_path: "task-bar/post.svg",
           icon_alt: "Posts timeline",
           title: "Posts timeline",
           description: "All blog posts and CTF writeups ordered by publication year." %>

<div class="timeline-shell">
  <ul class="timeline">
    <% @timeline.each do |year, items| %>
      <li class="mb-6">
        <div class="flex items-baseline justify-between mb-4">
          <h2 class="text-2xl font-semibold text-white"><%= year %></h2>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-slate-800 text-slate-200">
            <%= items.size %> posts
          </span>
        </div>

        <ul class="space-y-4">
          <% items.each do |item| %>
            <li class="timeline-item">
              <div class="timeline-date">
                <time datetime="<%= item[:published].iso8601 %>">
                  <%= item[:published].strftime('%Y-%m-%d') %>
                </time>
                <div class="text-xs mt-1 text-gray-500"><span class="inline-block bg-slate-800 px-2 py-0.5 rounded text-xs font-medium text-slate-200"><%= item[:which].upcase %></span></div>
              </div>

              <div class="timeline-connector">
                <div class="dot"></div>
              </div>

              <a href="<%= item[:link] %>" class="timeline-content" aria-label="Open <%= item[:title] %>">
                <span class="timeline-title">
                  <%= item[:title] %>
                </span>

                <div class="timeline-meta mt-1">
                    <%= item[:description] %>
                </div>

              </a>
            </li>
          <% end %>
        </ul>
      </li>
    <% end %>
  </ul>
</div>
</main>
