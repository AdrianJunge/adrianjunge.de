<% timeline_description = "Security research, CVEs, bug bounties, certificates, achievements, blog posts, and CTF writeups ordered by date." %>

<% content_for :head do %>
  <%= seo_meta_tags(
        title: "Timeline",
        description: timeline_description,
        canonical_path: timeline_path,
        json_ld: seo_collection_schema(title: "Timeline", description: timeline_description, canonical_path: timeline_path)
      ) %>
<% end %>

<%= render_taskbar_items %>
<%= render_terminal([], true) %>

<main class="content-page timeline-page">
<%= render "shared/content_hero",
           icon_path: "task-bar/post.svg",
           icon_alt: "Timeline",
           title: "Timeline",
           description: timeline_description %>

<div class="timeline-shell">
  <ul class="timeline">
    <% @timeline.each do |year, items| %>
      <li class="mb-6">
        <div class="flex items-baseline justify-between mb-4">
          <h2 class="text-2xl font-semibold text-white"><%= year %></h2>
          <span class="ui-pill bg-slate-800 text-slate-200">
            <%= items.size %> <%= items.size == 1 ? "item" : "items" %>
          </span>
        </div>

        <ul class="space-y-4">
          <% items.each do |item| %>
            <li class="timeline-item">
              <div class="timeline-date">
                <time datetime="<%= item[:published].iso8601 %>">
                  <%= item[:display_date] %>
                </time>
                <div class="text-xs mt-1 text-gray-500"><span class="ui-tag-pill bg-slate-800 text-slate-200"><%= item[:label] %></span></div>
              </div>

              <div class="timeline-connector">
                <div class="dot"></div>
              </div>

              <a href="<%= item[:link] %>" class="timeline-content ui-hover-lift" aria-label="Open <%= item[:title] %>">
                <span class="timeline-title">
                  <%= item[:title] %>
                </span>

                <% if item[:description].present? %>
                  <div class="timeline-meta mt-1">
                      <%= item[:description] %>
                  </div>
                <% end %>

                <span class="timeline-source">
                  <%= item[:source] %>
                  <% if item[:tags].any? %>
                    <span><%= item[:tags].first(3).join(" · ") %></span>
                  <% end %>
                </span>

              </a>
            </li>
          <% end %>
        </ul>
      </li>
    <% end %>
  </ul>
</div>
</main>
