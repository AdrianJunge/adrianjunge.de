<% timeline_description = "Security research, CVEs, bug bounties, certificates, achievements, blog posts, and CTF writeups ordered by date." %>

<% content_for :head do %>
  <%= seo_meta_tags(
        title: "Timeline",
        description: timeline_description,
        canonical_path: timeline_path,
        json_ld: seo_collection_schema(title: "Timeline", description: timeline_description, canonical_path: timeline_path)
      ) %>
<% end %>

<%= render_taskbar_items %>
<%= render_terminal([], true) %>

<main class="content-page timeline-page">
  <%= render "shared/content_hero",
             icon_path: "task-bar/post.svg",
             icon_alt: "Timeline",
             title: "Timeline",
             description: timeline_description %>

  <%= render "shared/content_filters",
             scope: "timeline",
             years: @filter_years,
             tags: @filter_tags,
             tag_groups: @filter_tag_groups,
             total: @timeline_items.length,
             search_id: "timeline-search-input",
             clear_id: "timeline-search-clear",
             search_value: @initial_query,
             placeholder: "Search writeups, CVEs, bounties, certificates...",
             tag_label: "Filters" %>

  <div class="timeline-shell">
    <ul class="timeline">
      <% @timeline.each do |year, items| %>
        <li class="timeline-year-group" data-filter-group="timeline">
          <div class="timeline-year-header">
            <h2><%= year %></h2>
            <span class="ui-pill bg-slate-800 text-slate-200" data-filter-group-count="timeline">
              <%= items.size %> <%= items.size == 1 ? "item" : "items" %>
            </span>
          </div>

          <ul class="timeline-year-items">
            <% items.each do |item| %>
              <% visible_tags = item[:tags].reject { |tag_name| [ WriteupWinner::FILTER_LABEL, item[:label] ].include?(tag_name) } %>
              <li
                class="timeline-item"
                data-filter-card="timeline"
                data-filter-text="<%= item[:search_text] %>"
                data-filter-years="<%= item[:published].year %>"
                data-filter-tags="<%= item[:tags].join("|") %>"
              >
                <div class="timeline-date">
                  <time datetime="<%= item[:published].iso8601 %>">
                    <%= item[:display_date] %>
                  </time>
                  <button
                    type="button"
                    class="filter-chip ui-hover-lift timeline-kind-pill"
                    data-filter-scope="timeline"
                    data-filter-tag="<%= item[:label] %>"
                    aria-pressed="false"
                    aria-label="Filter timeline by <%= item[:label] %>"
                  ><%= item[:label] %></button>
                </div>

                <div class="timeline-connector">
                  <div class="dot"></div>
                </div>

                <article class="timeline-content ui-card-surface ui-hover-lift">
                  <a href="<%= item[:link] %>" class="timeline-card-hitbox" aria-label="Open <%= item[:title] %>"></a>

                  <span class="timeline-title">
                    <%= item[:title] %>
                  </span>

                  <% if item[:writeup_winner].present? || visible_tags.any? %>
                    <span class="timeline-tags">
                      <% if item[:writeup_winner].present? %>
                        <button
                          type="button"
                          class="filter-chip writeup-winner-badge writeup-winner-badge-timeline writeup-winner-badge-filter"
                          data-filter-scope="timeline"
                          data-filter-tag="<%= WriteupWinner::FILTER_LABEL %>"
                          aria-pressed="false"
                          aria-label="Filter timeline by <%= WriteupWinner::FILTER_LABEL %>"
                          title="<%= item[:writeup_winner][:label] %>"
                        >
                          <%= tag.svg(
                                tag.path(
                                  d: "M12 2.75l2.12 5.78 6.13.23-4.82 3.8 1.68 5.9L12 15.05 6.89 18.46l1.68-5.9-4.82-3.8 6.13-.23L12 2.75z",
                                  fill: "currentColor"
                                ),
                                class: "writeup-winner-icon",
                                viewBox: "0 0 24 24",
                                aria: { hidden: true }
                              ) %>
                          <span class="writeup-winner-label"><%= item[:writeup_winner][:label] %></span>
                        </button>
                      <% end %>

                      <% visible_tags.first(6).each do |tag_name| %>
                        <button
                          type="button"
                          class="filter-chip ui-hover-lift timeline-tag-pill"
                          data-filter-scope="timeline"
                          data-filter-tag="<%= tag_name %>"
                          aria-pressed="false"
                          aria-label="Filter timeline by <%= tag_name %>"
                        ><%= tag_name %></button>
                      <% end %>
                    </span>
                  <% end %>

                  <% if item[:description].present? %>
                    <span class="timeline-meta">
                      <%= item[:description] %>
                    </span>
                  <% end %>

                  <span class="timeline-source">
                    <%= item[:source] %>
                  </span>
                </article>
              </li>
            <% end %>
          </ul>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="content-filter-empty" data-filter-empty="timeline" hidden>
    <p>No indexed content matches the current filters.</p>
  </div>
</main>
