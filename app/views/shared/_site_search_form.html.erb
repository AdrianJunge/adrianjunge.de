<form method="dialog" class="site-search-form" role="search" data-site-search-form>
  <label for="site-search-palette-query" class="sr-only">Search</label>
  <div class="search-wrapper">
    <input id="site-search-palette-query" name="q" class="content-filter-input" type="search" maxlength="200" placeholder="Search" autocomplete="off" data-site-search-query>
    <button type="button" class="search-clear-btn" data-site-search-clear aria-label="Clear search" hidden disabled>
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
</form>
