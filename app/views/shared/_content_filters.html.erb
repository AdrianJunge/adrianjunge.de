<% years = Array(local_assigns.fetch(:years, [])).compact.map(&:to_s).reject(&:blank?).uniq.sort.reverse %>
<% winner_filter_tag = WriteupWinner::FILTER_LABEL %>
<% authored_filter_tag = AuthoredChallenge::FILTER_LABEL %>
<% tags = Array(local_assigns.fetch(:tags, [])).compact.map(&:to_s).reject(&:blank?).uniq { |tag| tag.downcase }.sort_by { |tag| ContentRepository.filter_tag_sort_key(tag) } %>
<% tag_groups = Array(local_assigns.fetch(:tag_groups, [])).filter_map do |group|
     next unless group.is_a?(Hash)

     group_tags = Array(group[:tags] || group["tags"]).compact.map(&:to_s).reject(&:blank?)
     next if group_tags.empty?

     sort = (group[:sort] || group["sort"]).to_s
     sorted_group_tags = group_tags.uniq { |tag| tag.downcase }.sort_by { |tag| ContentTagTaxonomy.sort_key(tag) }

     {
       label: (group[:label] || group["label"]).to_s,
       sort: sort,
       tags: sorted_group_tags
     }
   end %>
<% tag_groups = [ { label: "", tags: tags } ] if tag_groups.empty? && tags.any? %>
<% total = local_assigns.fetch(:total, 0).to_i %>
<% scope = local_assigns.fetch(:scope) %>
<% search_id = local_assigns.fetch(:search_id, "#{scope}-search-input") %>
<% clear_id = local_assigns.fetch(:clear_id, "#{scope}-search-clear") %>
<% search_value = local_assigns.fetch(:search_value, nil) %>

<div class="content-filter-panel" data-filter-scope="<%= scope %>">
  <div class="content-filter-row">
    <div class="content-filter-search search-wrapper">
      <input
        type="text"
        id="<%= search_id %>"
        placeholder="<%= local_assigns.fetch(:placeholder, "Search...") %>"
        value="<%= search_value %>"
        class="content-filter-input"
        data-filter-search="<%= scope %>"
      >
      <button type="button" class="search-clear-btn" id="<%= clear_id %>" data-filter-clear="<%= scope %>" aria-label="Clear search">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <% if years.any? %>
      <% year_label_id = "#{scope}-year-filter-label" %>
      <% year_menu_id = "#{scope}-year-filter-menu" %>
      <div class="content-filter-select-wrap" data-year-dropdown="<%= scope %>">
        <span id="<%= year_label_id %>"><%= local_assigns.fetch(:year_label, "Year") %></span>
        <span class="content-filter-select-control">
          <select class="content-filter-select content-filter-native-select" data-filter-year="<%= scope %>" aria-hidden="true" tabindex="-1">
            <option value="">All years</option>
            <% years.each do |year| %>
              <option value="<%= year %>"><%= year %></option>
            <% end %>
          </select>
          <button
            type="button"
            class="content-filter-year-button"
            data-year-dropdown-button="<%= scope %>"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-controls="<%= year_menu_id %>"
            aria-labelledby="<%= year_label_id %>"
          >
            <span data-year-dropdown-label="<%= scope %>">All years</span>
          </button>
        </span>
        <div
          id="<%= year_menu_id %>"
          class="content-filter-year-menu"
          data-year-dropdown-menu="<%= scope %>"
          role="listbox"
          aria-labelledby="<%= year_label_id %>"
          hidden
        >
          <button
            type="button"
            class="content-filter-year-option is-active"
            data-year-dropdown-option="<%= scope %>"
            data-year-value=""
            role="option"
            aria-selected="true"
          >All years</button>
          <% years.each do |year| %>
            <button
              type="button"
              class="content-filter-year-option"
              data-year-dropdown-option="<%= scope %>"
              data-year-value="<%= year %>"
              role="option"
              aria-selected="false"
            ><%= year %></button>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <% if tag_groups.any? %>
    <div class="content-filter-tags" aria-label="<%= local_assigns.fetch(:tag_label, "Tags") %>">
      <span class="content-filter-tags-label"><%= local_assigns.fetch(:tag_label, "Tags") %></span>
      <div class="content-filter-tag-groups">
        <% tag_groups.each do |group| %>
          <div class="content-filter-tag-group">
            <% if group[:label].present? %>
              <span class="content-filter-tag-group-label"><%= group[:label] %></span>
            <% end %>
            <div class="content-filter-tag-list">
              <% group[:tags].each do |filter_tag| %>
                <% winner_filter = filter_tag == winner_filter_tag %>
                <% authored_filter = filter_tag == authored_filter_tag %>
                <% difficulty_filter = WriteupDifficulty.filter_label?(filter_tag) %>
                <% severity_filter = !difficulty_filter && ContentSeverityTag.recognized?(filter_tag) %>
                <% cve_filter = ContentVulnerabilityTag.cve?(filter_tag) %>
                <% cwe_filter = ContentVulnerabilityTag.cwe?(filter_tag) %>
                <% category_filter = group[:sort] == "category" || (!winner_filter && !authored_filter && !difficulty_filter && !severity_filter && !cve_filter && !cwe_filter && ContentCategoryTag.recognized?(filter_tag)) %>
                <%= content_filter_chip(
                      filter_tag,
                      scope: scope,
                      class_name: "content-filter-tag-chip",
                      winner: winner_filter,
                      authored: authored_filter,
                      difficulty_key: difficulty_filter ? filter_tag : nil,
                      category_key: category_filter ? filter_tag : nil,
                      severity_key: severity_filter ? filter_tag : nil,
                      cve: cve_filter,
                      cwe: cwe_filter
                    ) %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="content-filter-state">
    <span data-filter-count="<%= scope %>"><%= total %> / <%= total %> <%= total == 1 ? "item" : "items" %></span>
    <button type="button" class="content-filter-reset" data-filter-reset="<%= scope %>" aria-hidden="true" tabindex="-1">Clear filters</button>
  </div>
</div>
