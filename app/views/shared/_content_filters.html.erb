<div class="content-filter-panel" data-filter-scope="<%= filters.scope %>" data-filter-aliases="<%= filters.aliases.to_json %>" inert>
  <div class="<%= class_names("content-filter-row", "content-filter-row-with-order": filters.order.present?, "content-filter-row-with-view": filters.view.present?) %>">
    <div class="content-filter-search search-wrapper">
      <label for="<%= filters.search_id %>" class="sr-only">Search</label>
      <input
        type="search"
        id="<%= filters.search_id %>"
        placeholder="<%= filters.placeholder %>"
        value="<%= filters.search_value %>"
        class="content-filter-input"
        data-filter-search="<%= filters.scope %>"
      >
      <button type="button" class="search-clear-btn" id="<%= filters.clear_id %>" data-filter-clear="<%= filters.scope %>" aria-label="Clear search">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <% if filters.view.present? %>
      <div class="content-filter-select-wrap content-filter-view-wrap">
        <label for="<%= filters.scope %>-view-filter">Show</label>
        <select id="<%= filters.scope %>-view-filter" name="view" class="content-filter-select" data-filter-view="<%= filters.scope %>">
          <%= options_for_select([["All entries", "all"], ["Posts", "posts"]], filters.view) %>
        </select>
      </div>
    <% end %>

    <% if filters.years.any? %>
      <div class="content-filter-select-wrap">
        <label for="<%= filters.scope %>-year-filter"><%= filters.year_label %></label>
        <select id="<%= filters.scope %>-year-filter" name="year" class="content-filter-select" data-filter-year="<%= filters.scope %>">
          <option value="">All years</option>
          <% filters.years.each do |year| %>
            <option value="<%= year %>"><%= year %></option>
          <% end %>
        </select>
      </div>
    <% end %>

    <% if filters.order.present? %>
      <div class="content-filter-select-wrap">
        <label for="<%= filters.scope %>-order-filter">Order</label>
        <select id="<%= filters.scope %>-order-filter" name="order" class="content-filter-select" data-filter-order="<%= filters.scope %>">
          <%= options_for_select([["Newest first", "newest"], ["Oldest first", "oldest"]], filters.order) %>
        </select>
      </div>
    <% end %>
  </div>

  <% if filters.common_group %>
    <div class="content-filter-common" role="group" aria-label="Common filters">
      <%= render "shared/filter_tag_group", group: filters.common_group, scope: filters.scope %>
    </div>
    <% if filters.additional_groups.any? %>
      <details class="content-filter-more">
        <summary>More filters</summary>
        <div class="content-filter-tag-groups">
          <% filters.additional_groups.each do |group| %>
            <%= render "shared/filter_tag_group", group: group, scope: filters.scope %>
          <% end %>
        </div>
      </details>
    <% end %>
  <% end %>
  <% unless filters.external_status %>
    <%= render "shared/content_filter_state", scope: filters.scope, total: filters.total %>
  <% end %>
</div>
<noscript><style>.content-filter-panel { display: none; }</style><p class="content-filter-help"><%= filters.view == "posts" ? "Blog posts and CTF writeups are shown." : "All entries are shown." %> Use your browser’s Find command to search this page.<% if filters.view == "posts" %> <%= link_to "Show all entries", timeline_path %>.<% end %></p></noscript>
