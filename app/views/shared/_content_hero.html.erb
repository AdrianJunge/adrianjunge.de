<% invert_icon = local_assigns.fetch(:invert_icon, true) %>
<% icon_classes = [ "content-hero-icon" ] %>
<% icon_classes << "content-hero-icon-inverted" if invert_icon %>
<% icon_classes << local_assigns[:icon_class] if local_assigns[:icon_class].present? %>
<% link_target = local_assigns[:external] ? "_blank" : nil %>
<% link_rel = local_assigns[:external] ? "noopener noreferrer" : nil %>
<% actions = Array(local_assigns.fetch(:actions, [])) %>
<% description_html = local_assigns[:description_html] %>
<% description_class = [ "content-hero-description", local_assigns[:description_class] ].compact.join(" ") %>
<% after_content = local_assigns[:after_content] %>

<section class="content-hero">
  <div class="content-hero-inner">
    <% title_cluster = capture do %>
      <span class="content-hero-icon-wrap">
        <%= content_image_tag(icon_path, alt: icon_alt, class: icon_classes.join(" "), loading: "eager") %>
      </span>
      <h1><%= title %></h1>
    <% end %>

    <div class="content-hero-title-row">
      <% if local_assigns[:url].present? %>
        <%= link_to local_assigns[:url],
                    class: "content-hero-title-cluster content-hero-title-link",
                    target: link_target,
                    rel: link_rel,
                    aria: { label: "Open #{title}" },
                    title: "Open #{title}" do %>
          <%= title_cluster %>
        <% end %>
      <% else %>
        <div class="content-hero-title-cluster">
          <%= title_cluster %>
        </div>
      <% end %>

      <% if actions.any? %>
        <div class="content-hero-actions content-hero-feed-actions">
          <% actions.each do |action| %>
            <% href = action[:href] || action["href"] %>
            <% link_class = action[:class] || action["class"] %>
            <% icon_path = action[:icon_path] || action["icon_path"] %>
            <% icon_class = action[:icon_class] || action["icon_class"] %>
            <% label = action[:label] || action["label"] %>
            <% alt = action[:alt] || action["alt"] || label %>

            <a href="<%= href %>" class="content-hero-feed-link <%= link_class %>" aria-label="<%= label %>" title="<%= label %>">
              <%= image_tag(icon_path, alt: alt, class: icon_class) %>
            </a>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if description_html.present? %>
      <div class="<%= description_class %>">
        <%= description_html %>
      </div>
    <% elsif description.present? %>
      <p class="<%= description_class %>"><%= description %></p>
    <% end %>

    <% if after_content.present? %>
      <%= after_content %>
    <% end %>
  </div>
</section>
