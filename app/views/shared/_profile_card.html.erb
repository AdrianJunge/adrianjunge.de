<% card = local_assigns.fetch(:card) %>
<% tags = profile_card_ordered_tags(card[:tags]) %>
<% body_blocks = Array(card[:body_blocks]).compact %>
<% timeline_items = Array(card[:timeline]).compact %>
<% child_cards = Array(card[:children]).compact %>
<% collapsible = card[:collapsible] && (body_blocks.any? || timeline_items.any? || child_cards.any?) %>
<% card_url = collapsible ? nil : card[:card_url].presence %>
<% reading_time = card[:reading_time].to_s.presence %>
<% icon_path = card[:icon].to_s.presence %>
<% card_classes = [ "profile-card", "aboutme-card", "ui-card-surface", ("ui-hover-lift" if card_url.present?), card[:class_name], ("aboutme-card-static" unless collapsible), ("aboutme-card-linked" if card_url.present?), ("aboutme-card-nested" if card[:nested]) ].compact.join(" ") %>
<% main_classes = [ "aboutme-card-main", card[:main_class] ].compact.join(" ") %>
<% title_classes = [ "aboutme-card-title", card[:title_class] ].compact.join(" ") %>
<% tag_container_classes = [ "aboutme-card-tags", card[:tags_class] ].compact.join(" ") %>
<% summary_classes = [ "aboutme-card-summary", card[:description_class] ].compact.join(" ") %>
<% heading_tag = card[:heading_tag].presence || (card[:nested] ? :h4 : :h3) %>
<% header_body_content = capture do %>
  <% if card[:title].present? %>
    <% if card[:kicker].present? %>
      <span class="aboutme-card-kicker"><%= card[:kicker] %></span>
    <% end %>
    <%= content_tag(heading_tag, class: title_classes) do %>
      <%= card[:title] %>
    <% end %>
  <% end %>

  <% if tags.any? %>
    <span class="<%= tag_container_classes %>">
      <% tags.each do |tag| %>
        <%= profile_card_tag(label: tag[:label], filter_tag: tag[:filter_tag], url: tag[:url], class_name: tag[:class_name], datetime: tag[:datetime]) %>
      <% end %>
    </span>
  <% end %>

  <% if card[:description].present? %>
    <span class="<%= summary_classes %>">
      <%= profile_card_optional_link(
            card[:description],
            card[:description_url],
            class_name: card[:description_link_class],
            aria_label: card[:description_aria_label],
            title: card[:description_title]
          ) %>
    </span>
  <% end %>

  <% if reading_time.present? %>
    <span class="aboutme-card-reading-time"><%= reading_time %></span>
  <% end %>
<% end %>
<% header_content = capture do %>
  <%= render "shared/card_shell",
             media: icon_path.present? ? {
               image: icon_path,
               alt: "",
               image_class: "blog-logo aboutme-card-icon",
               wrapper_class: "blog-post-card-logo aboutme-card-logo"
             } : {},
             content_class: "content-card-content blog-post-card-content aboutme-card-header-content",
             body_class: [ "content-card-body", "blog-post-card-details", main_classes ].compact.join(" "),
             body_content: header_body_content,
             content_tag_name: :div,
             body_tag_name: :div,
             wrap_content: true,
             wrap_body: true %>
<% end %>
<% body_content = capture do %>
  <% body_blocks.each do |block| %>
    <div class="aboutme-detail-block">
      <% if block[:title].present? %>
        <h3><%= block[:title] %></h3>
      <% end %>
      <% if block[:text].present? %>
        <p><%= block[:text] %></p>
      <% end %>
      <% if Array(block[:items]).any? %>
        <ul class="aboutme-card-details">
          <% Array(block[:items]).each do |item| %>
            <li><%= item %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  <% end %>

  <% if timeline_items.any? %>
    <div class="aboutme-detail-block">
      <h3><%= card[:timeline_title].presence || "Disclosure timeline" %></h3>
      <ol class="aboutme-timeline">
        <% timeline_items.each do |item| %>
          <% item_upcoming = upcoming_date?(item["date"]) %>
          <% event_label = item["event"].presence || item["title"].presence %>
          <% event_url = item["url"].presence %>
          <%= content_tag(
                :li,
                id: item["id"].presence,
                class: ("aboutme-timeline-item-upcoming" if item_upcoming),
                data: { upcoming: item_upcoming }
              ) do %>
            <% if item["date"].present? %>
              <span class="aboutme-timeline-date-row">
                <%= content_upcoming_badge(class_name: "aboutme-upcoming-badge") if item_upcoming %>
                <time datetime="<%= item["date"] %>"><%= item["date"] %></time>
              </span>
            <% end %>
            <span class="aboutme-timeline-content">
              <% if event_url.present? && event_label.present? && item["link_style"] == "tag" %>
                <%= profile_card_optional_link(
                      event_label,
                      event_url,
                      class_name: "aboutme-timeline-link aboutme-timeline-event-link",
                      aria_label: "Open #{event_label}",
                      title: "Open #{event_label}"
                    ) %>
              <% elsif event_url.present? && event_label.present? %>
                <%= profile_card_optional_link(
                      event_label,
                      event_url,
                      class_name: "aboutme-timeline-link",
                      aria_label: "Open #{event_label}",
                      title: "Open #{event_label}"
                    ) %>
              <% elsif event_label.present? %>
                <span class="aboutme-timeline-title"><%= event_label %></span>
              <% end %>
              <% if item["summary"].present? %>
                <span class="aboutme-timeline-summary"><%= item["summary"] %></span>
              <% end %>
            </span>
          <% end %>
        <% end %>
      </ol>
    </div>
  <% end %>

  <% if child_cards.any? %>
    <ol class="aboutme-card-children">
      <% child_cards.each do |child_card| %>
        <li>
          <%= render_profile_card(child_card.merge(nested: true)) %>
        </li>
      <% end %>
    </ol>
  <% end %>
<% end %>

<% if collapsible %>
  <article class="<%= card_classes %>" id="<%= card[:id].presence %>" data-card-disclosure>
    <div class="aboutme-card-header">
      <%= header_content %>
    </div>
    <details class="profile-card-details">
      <summary aria-label="Details for <%= card[:title] %>">Details</summary>
      <div class="aboutme-card-body">
        <%= body_content %>
      </div>
    </details>
  </article>
<% else %>
  <article class="<%= card_classes %>" id="<%= card[:id].presence %>">
    <% if card_url.present? %>
      <%= link_to(card_url, profile_card_link_attributes(card_url, card[:aria_label].presence || card[:title].presence || "Open item")) do %>
        <span class="aboutme-card-link-label"><%= card[:aria_label].presence || card[:title].presence || "Open item" %></span>
      <% end %>
    <% end %>
    <div class="aboutme-card-header">
      <%= header_content %>
    </div>

    <% if body_blocks.any? || child_cards.any? %>
      <div class="aboutme-card-body">
        <%= body_content %>
      </div>
    <% end %>
  </article>
<% end %>
