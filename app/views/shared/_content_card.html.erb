<% tags_content = capture do %>
  <% if card[:tags].any? %>
    <% tag_list = safe_join(card[:tags].map { |card_tag| content_card_tag(card_tag, default_scope: card[:filter_scope], default_interactive: card[:interactive_tags]) }.compact) %>
    <% if card[:tags_outer_class].present? %>
      <span class="<%= card[:tags_outer_class] %>">
        <span class="<%= card[:tags_class] %>">
          <%= tag_list %>
        </span>
      </span>
    <% else %>
      <span class="<%= card[:tags_class] %>">
        <%= tag_list %>
      </span>
    <% end %>
  <% end %>
<% end %>

<% authors_content = capture do %>
  <% if card[:authors].any? %>
    <span class="<%= card[:authors_class] %>">
      <% if card[:authors_label].present? %>
        <span><%= card[:authors_label] %></span>
      <% end %>
      <%= safe_join(card[:authors].map { |author| content_author_node(author) }, ", ".html_safe) %>
    </span>
  <% end %>
<% end %>

<% text_content = capture do %>
  <% if card[:title].present? %>
    <%= content_tag(card[:title_tag], card[:title], class: card[:title_class]) %>
  <% end %>

  <%= tags_content %>
  <%= authors_content %>

  <% if card[:description].present? %>
    <%= content_tag(card[:description_tag], italicize_proper_names(card[:description]), class: card[:description_class]) %>
  <% end %>

  <% if card[:date].present? || card[:reading_time].present? || card[:meta_items].any? %>
    <span class="<%= card[:date_class] %>">
      <% if card[:date].present? %>
        <% if card[:date_datetime].present? %>
          <time datetime="<%= card[:date_datetime] %>" class="<%= card[:date_text_class] %>"><%= card[:date] %></time>
        <% else %>
          <span class="<%= card[:date_text_class] %>"><%= card[:date] %></span>
        <% end %>
      <% end %>

      <% if card[:reading_time].present? %>
        <% if card[:date].present? %>
          <span class="content-card-meta-separator" aria-hidden="true">·</span>
        <% end %>
        <span class="<%= card[:reading_time_class] %>"><%= card[:reading_time] %></span>
      <% end %>

      <% card[:meta_items].each_with_index do |meta_item, index| %>
        <% if card[:date].present? || card[:reading_time].present? || index.positive? %>
          <span class="content-card-meta-separator" aria-hidden="true">·</span>
        <% end %>
        <span class="<%= meta_item[:class_name] %>"><%= meta_item[:label] %></span>
      <% end %>
    </span>
  <% end %>

  <% if card[:source].present? %>
    <span class="<%= card[:source_class] %>"><%= card[:source] %></span>
  <% end %>
<% end %>

<% body_content = capture do %>
  <% if card[:text_class].present? %>
    <span class="<%= card[:text_class] %>"><%= text_content %></span>
  <% else %>
    <%= text_content %>
  <% end %>
<% end %>

<% inner_content = capture do %>
  <% if card[:url].present? %>
    <%= content_tag(:a, "", content_card_link_attributes(card[:url], card[:aria_label], class_name: card[:hitbox_class]).merge(href: card[:url])) %>
  <% end %>

  <% if card[:section_link] %>
    <%= content_tag(
          :a,
          image_tag(card[:section_link][:icon], alt: "", class: "content-card-section-icon", aria: { hidden: true }),
          content_link_options(card[:section_link][:url]).merge(
            href: card[:section_link][:url],
            class: card[:section_link][:class_name],
            aria: { label: card[:section_link][:label] },
            title: card[:section_link][:title],
            data: card[:section_link][:data]
          )
        ) %>
  <% end %>

  <%= render "shared/card_shell",
             media: card[:media],
             media_html: card[:media_html],
             content_class: card[:content_class],
             body_class: card[:body_class],
             body_content: body_content,
             wrap_content: true,
             wrap_body: true %>
<% end %>

<%= content_tag(:article, inner_content, card[:root_attributes]) %>
