<% article_description_text = description.to_s.squish %>
<% article_description_label = local_assigns.fetch(:label, "Description") %>

<% if article_description_text.present? %>
  <section class="article-description" aria-label="<%= article_description_label %>">
    <h2 class="article-description-heading">Description</h2>
    <p><%= article_description_text %></p>
  </section>
<% end %>
