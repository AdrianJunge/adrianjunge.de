<nav id="toc" class="table-of-content bg-primary" aria-label="Table of contents">
  <div class="toc-header">
    <h2 class="text-slate-100 font-semibold">Table of contents</h2>
    <button id="toc-toggle" type="button" class="collapse-toc-button toc-toggle-button"
            title="Collapse table of contents" aria-label="Collapse table of contents"
            data-toc-toggle="toc" aria-expanded="true" aria-controls="toc">‹</button>
  </div>
  <details class="article-toc-compact">
    <summary title="Table of contents">
      <span class="article-toc-label">Contents</span>
      <% if word_total.to_i.positive? %>
        <%= render "shared/post_progress", word_total: word_total %>
      <% end %>
    </summary>
    <div id="toc-body"><%= render "shared/toc_links", headings: headings %></div>
  </details>
</nav>
