<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind" %>

    <link rel="alternate" type="application/rss+xml" title="adrianjunge.de (RSS)" href="<%= feed_xml_url %>">
    <link rel="alternate" type="application/atom+xml" title="adrianjunge.de (Atom)" href="<%= feed_url(format: :atom) %>">
    <link rel="alternate" type="application/feed+json" title="adrianjunge.de (JSON Feed)" href="<%= feed_json_url %>">

    <%= javascript_importmap_tags %>
    <%= favicon_link_tag asset_path('favicon.svg') %>

    <% if content_for?(:head) %>
      <%= yield :head %>
    <% else %>
      <%= seo_meta_tags %>
    <% end %>
  </head>
  <body class="site-background min-h-screen flex flex-col">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <%= render_taskbar_items %>
    <%= render_terminal(@terminal_paths || [], true) %>
    <p id="terminal-status" class="terminal-status" role="status" aria-live="polite"></p>

    <% if current_page?(root_path) == false %>
      <a href="<%= parent_path %>" class="<%= class_names("back-button-floating back-button ui-icon-button", "article-back-desktop" => content_for?(:article_navigation)) %>" aria-label="Back">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
      </a>
    <% end %>

    <div class="flex-grow">
      <%= yield %>
    </div>

    <%= render 'layouts/footer' %>

  </body>
</html>
