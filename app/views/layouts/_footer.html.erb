<% footer_icon_class = "footer-icon" %>

<footer class="site-footer text-white">
  <div class="footer-container mx-auto text-center">
    <div class="footer-links">
      <%= link_to(image_tag("task-bar/github.svg", alt: "Github Icon", class: footer_icon_class), "https://github.com/AdrianJunge/", target: "_blank", rel: "noopener noreferrer", class: "footer-link ui-hover-lift", aria: { label: "GitHub" }) %>
      <%= link_to(image_tag("task-bar/linkedin.svg", alt: "Linkedin Icon", class: footer_icon_class), "https://www.linkedin.com/in/adrian-junge-998a63296/", target: "_blank", rel: "noopener noreferrer", class: "footer-link ui-hover-lift", aria: { label: "LinkedIn" }) %>
      <%= link_to(image_tag("task-bar/discord.svg", alt: "Discord Icon", class: footer_icon_class), "https://discord.com/users/305624492221267968/", target: "_blank", rel: "noopener noreferrer", class: "footer-link ui-hover-lift", aria: { label: "Discord" }) %>
      <%= link_to(image_tag("task-bar/telegram.svg", alt: "Telegram Icon", class: footer_icon_class), "https://t.me/FullyIncredibleCreativeUsername", target: "_blank", rel: "noopener noreferrer", class: "footer-link ui-hover-lift", aria: { label: "Telegram" }) %>
      <%= link_to(image_tag("task-bar/instagram.svg", alt: "Instagram Icon", class: footer_icon_class), "https://www.instagram.com/adrian_jnge/", target: "_blank", rel: "noopener noreferrer", class: "footer-link ui-hover-lift", aria: { label: "Instagram" }) %>
      <%= link_to(image_tag("task-bar/mail.svg", alt: "Mail Icon", class: footer_icon_class), "mailto:todo@adrianjunge.de", class: "footer-link ui-hover-lift", aria: { label: "Email Adrian Junge" }) %>
    </div>

    <div class="footer-info">
      <p>© <%= Time.current.year %> All rights reserved</p>
      <p>
        <a href="https://github.com/AdrianJunge/adrianjunge.de" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:underline">
          View Source Code
        </a>
      </p>
    </div>
  </div>
</footer>
