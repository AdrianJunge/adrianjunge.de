<% footer_icon_class = "footer-icon" %>

<footer class="site-footer text-white">
  <div class="footer-container mx-auto text-center">
    <div class="footer-links">
      <%= link_to(content_image_tag("task-bar/github.svg", alt: "Github Icon", class: footer_icon_class), SiteProfile.social_links.fetch(:github), target: "_blank", rel: "noopener noreferrer", class: "footer-link ui-hover-lift", aria: { label: "GitHub" }) %>
      <%= link_to(content_image_tag("task-bar/linkedin.svg", alt: "Linkedin Icon", class: footer_icon_class), SiteProfile.social_links.fetch(:linkedin), target: "_blank", rel: "noopener noreferrer", class: "footer-link ui-hover-lift", aria: { label: "LinkedIn" }) %>
      <%= link_to(content_image_tag("task-bar/discord.svg", alt: "Discord Icon", class: footer_icon_class), SiteProfile.social_links.fetch(:discord), target: "_blank", rel: "noopener noreferrer", class: "footer-link ui-hover-lift", aria: { label: "Discord" }) %>
      <%= link_to(content_image_tag("task-bar/telegram.svg", alt: "Telegram Icon", class: footer_icon_class), SiteProfile.social_links.fetch(:telegram), target: "_blank", rel: "noopener noreferrer", class: "footer-link ui-hover-lift", aria: { label: "Telegram" }) %>
      <%= link_to(content_image_tag("task-bar/instagram.svg", alt: "Instagram Icon", class: footer_icon_class), SiteProfile.social_links.fetch(:instagram), target: "_blank", rel: "noopener noreferrer", class: "footer-link ui-hover-lift", aria: { label: "Instagram" }) %>
      <%= link_to(content_image_tag("task-bar/mail.svg", alt: "Mail Icon", class: footer_icon_class), SiteProfile.email_url, class: "footer-link ui-hover-lift", aria: { label: "Email #{SiteProfile.name}" }) %>
    </div>


    <div class="footer-info">
      <p>© <%= Time.current.year %> All rights reserved</p>
      <p>
        <a href="<%= SiteProfile.source_url %>" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:underline">
          View Source Code
        </a>
      </p>
    </div>
  </div>
</footer>
