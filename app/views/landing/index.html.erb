<% content_for :head do %>
  <%= seo_meta_tags(
        title: "Welcome to my bug collection 🐛",
        description: SeoHelper::DEFAULT_DESCRIPTION,
        canonical_path: root_path,
        image: "landing/profile.png",
        json_ld: seo_website_schema
      ) %>
<% end %>

<%= render_taskbar_items %>
<%= render_terminal([
  { label: "about", url: about_path },
  { label: "ctf", url: ctf_path },
  { label: "blog", url: blog_path },
  { label: "search", url: search_path },
  { label: "timeline", url: timeline_path }
], true) %>
<% timeline_link = timeline_path %>
<% about_link = about_path %>
<% kit_link = "https://www.kit.edu" %>
<% kitctf_link = "https://kitctf.de" %>
<% landing_metrics = [
  { label: "CVEs", value: @amount_cves, link: about_path(anchor: "cves") },
  { label: "Bug bounties", value: @amount_bug_bounties, link: about_path(anchor: "bug-bounties") },
  { label: "Created Challenges", value: @amount_challenges, link: about_path(anchor: "my-challenges") },
  { label: "Certificates", value: @amount_certificates, link: about_path(anchor: "certificates") },
  { label: "Achievements", value: @amount_achievements, link: about_path(anchor: "achievements") },
  { label: "Posts", value: @amount_posts, link: timeline_link }
] %>

<main class="landing-page">
<section id="landing-top">
    <div class="landing-hero-shell">
        <div class="landing-hero-copy">
            <p class="landing-kicker">Adrian "vurlo" Junge</p>
            <h1>Welcome to my <span class="landing-title-nowrap">bug collection <span class="landing-title-emoji">🐛</span></span></h1>
            <p class="landing-lead">
                CTF player, vulnerability researcher, and computer science student creating writeups, collecting CVEs, bounties, and notes from real targets and challenges. I poke things politely and occasionally convince software to confess.
            </p>

            <div class="landing-typed-line">
                <span id="typing" class="font-medium inline-block min-h-[1.5rem]"></span>
            </div>

            <div class="landing-actions" aria-label="Primary links">
                <a href="<%= timeline_link %>" class="landing-action landing-action-primary ui-hover-lift">
                    <%= image_tag("task-bar/post.svg", alt: "", class: "landing-action-icon", aria: { hidden: true }) %>
                    <span>Timeline</span>
                </a>
                <a href="<%= about_link %>" class="landing-action landing-action-secondary ui-hover-lift">
                    <%= image_tag("task-bar/about.svg", alt: "", class: "landing-action-icon", aria: { hidden: true }) %>
                    <span>About me</span>
                </a>
                <a href="<%= search_path %>" class="landing-action landing-action-secondary ui-hover-lift">
                    <%= image_tag("task-bar/search.svg", alt: "", class: "landing-action-icon", aria: { hidden: true }) %>
                    <span>Global Search</span>
                </a>
            </div>
        </div>

        <aside class="landing-profile-panel" aria-label="Profile summary">
            <%= image_tag("landing/profile.png", alt: "Adrian Junge profile image", class: "landing-profile-image") %>

            <div class="landing-affiliation-links">
                <a href="<%= kitctf_link %>" target="_blank" rel="noopener noreferrer" class="landing-affiliation-link ui-hover-lift">
                    <%= image_tag("landing/kitctf.png", alt: "", aria: { hidden: true }) %>
                    <span>KITCTF</span>
                </a>
                <a href="<%= kit_link %>" target="_blank" rel="noopener noreferrer" class="landing-affiliation-link ui-hover-lift">
                    <%= image_tag("landing/kit.png", alt: "", aria: { hidden: true }) %>
                    <span>KIT</span>
                </a>
            </div>
        </aside>
    </div>

    <div class="landing-metrics" aria-label="Site and security profile counters">
        <% landing_metrics.each do |metric| %>
            <a href="<%= metric[:link] %>" class="landing-metric ui-hover-lift">
                <span class="landing-metric-value"><%= metric[:value] %></span>
                <span class="landing-metric-label"><%= metric[:label] %></span>
            </a>
        <% end %>
    </div>

    <div id="scroll-down-button" class="absolute bottom-8">
        <button
            type="button"
            class="back-button ui-icon-button"
            aria-label="Scroll down"
            onclick="document.getElementById('landing-bottom').scrollIntoView({behavior:'smooth'})"
        >
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14M19 12l-7 7-7-7"/>
            </svg>
        </button>
    </div>
</section>

<section id="landing-bottom">
    <% if @featured_items.any? %>
        <section class="landing-featured-section" aria-labelledby="landing-featured-title">
            <h2 id="landing-featured-title" class="text-3xl font-bold mb-6 text-white text-center">Featured work</h2>

            <div class="landing-featured-grid">
                <% @featured_items.each do |item| %>
                    <a href="<%= item[:link] %>" class="landing-featured-card ui-hover-lift">
                        <span class="landing-featured-topline">
                            <span class="landing-featured-kind"><%= item[:label] %></span>
                            <time datetime="<%= item[:published].iso8601 %>"><%= item[:display_date] %></time>
                        </span>

                        <span class="landing-featured-title"><%= item[:title] %></span>

                        <% if item[:description].present? %>
                            <span class="landing-featured-description"><%= truncate(item[:description], length: 180) %></span>
                        <% end %>

                        <span class="landing-featured-meta">
                            <span><%= item[:source] %></span>
                            <% if item[:cve_id].present? %>
                                <span><%= item[:cve_id] %></span>
                            <% elsif item[:writeup_winner].present? %>
                                <span><%= item[:writeup_winner][:label] %></span>
                            <% end %>
                        </span>
                    </a>
                <% end %>
            </div>
        </section>
    <% end %>

    <h2 class="text-3xl font-bold mb-6 text-white text-center">Latest notes</h2>

    <div class="landing-writeup-cards">
        <% @most_recent_posts.each do |post| %>
            <% if post[:type] == "blog" %>
                <% blog_config = @blogs[post[:slug]] || {} %>
                <% post_title = blog_config["title"].presence || post[:title] %>
                <% post_link = blog_post_path(post[:slug]) %>
                <% post_logo = blog_config["logo"] %>
                <% post_categories = post[:categories] %>
            <% elsif post[:type] == "ctf" %>
                <% post_title = post[:title] %>
                <% post_link = post[:link] %>
                <% post_logo = post[:logo] %>
                <% post_categories = post[:categories] %>
            <% end %>

            <div class="blog-post-entry">
                <a href="<%= post_link %>" class="blog-post-card ui-hover-lift">
                    <div class="blog-post-card-content">
                        <div class="blog-post-card-logo">
                            <% if post_logo.present? %>
                                <%= image_tag(post_logo, alt: "#{post_title} Logo", class: "blog-logo") %>
                            <% else %>
                                <div style="font-size: 3rem;">📝</div>
                            <% end %>
                        </div>

                        <div class="blog-post-card-details">
                            <h3 class="blog-post-title"><%= post_title %></h3>

                            <div class="blog-post-meta">
                                <div class="flex flex-wrap gap-2">
                                    <% if post_categories.present? %>
                                        <% post_categories.each do |category| %>
                                            <span class="ui-tag-pill text-white bg-slate-700"><%= category %></span>
                                        <% end %>
                                    <% end %>
                                </div>
                            </div>

                            <p class="blog-post-description"><%= truncate(post[:description], length: 200) %></p>

                            <div class="blog-post-date">
                                <span class="blog-post-date-text"><%= post[:published].strftime("%Y-%m-%d") %></span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        <% end %>
    </div>

</section>

</main>
