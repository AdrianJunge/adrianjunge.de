<% content_for :head do %>
  <% landing_description = SeoHelper::DEFAULT_DESCRIPTION %>
  <% landing_latest_items = Array(@most_recent_posts).map { |post| { title: post[:title], link: post[:link] } } %>
  <%= seo_meta_tags(
        title: "Welcome to my bug collection 🐛",
        description: landing_description,
        canonical_path: root_path,
        image: "landing/profile.png",
        json_ld: [
          seo_website_schema(description: landing_description),
          seo_collection_schema(
            title: "Latest notes",
            description: landing_description,
            canonical_path: root_path,
            items: landing_latest_items
          )
        ],
        breadcrumbs: [
          { title: "Home", link: root_path }
        ]
      ) %>
<% end %>

<%= render_taskbar_items %>
<%= render_terminal([
  { label: "about", url: about_path },
  { label: "ctf", url: ctf_path },
  { label: "blog", url: blog_path },
  { label: "timeline", url: timeline_path }
], true) %>
<% timeline_link = timeline_path %>
<% about_link = about_path %>
<% discord_link = "https://discord.com/users/305624492221267968/" %>
<% kitctf_link = "https://kitctf.de/" %>
<% kit_link = "https://www.kit.edu/" %>
<% pgp_link = "/pgp-vurlo.asc" %>
<% landing_metrics = [
  { label: "Posts", value: @amount_posts, sublabel: @amount_post_reading_time, link: timeline_link },
  { label: "CVEs", value: @amount_cves, link: about_path(anchor: "cves") },
  { label: "Bounties", value: @amount_bug_bounties, link: about_path(anchor: "bug-bounties") },
  { label: "& more...", link: about_link }
] %>

<main class="landing-page">
<section id="landing-top">
    <div class="landing-hero-shell">
        <div class="landing-hero-copy">
            <p class="landing-kicker">Adrian Junge (vurlo)</p>
            <h1>Welcome to my <span class="landing-title-nowrap">bug collection <span class="landing-title-emoji">🐛</span></span></h1>
            <p class="landing-lead">
                CTF player, vulnerability researcher, and computer science student creating writeups, collecting CVEs, bounties, and notes from real targets and challenges, occasionally algorithmic and LeetCode challenges. I poke things politely and occasionally convince software to confess.
            </p>

            <div class="landing-typed-line">
                <span id="typing" class="font-medium inline-block min-h-[1.5rem]"></span>
            </div>

            <div class="landing-actions" aria-label="Primary links">
                <a href="<%= timeline_link %>" class="landing-action landing-action-primary ui-hover-lift">
                    <%= image_tag("task-bar/timeline.svg", alt: "", class: "landing-action-icon", aria: { hidden: true }) %>
                    <span>Timeline</span>
                </a>
                <a href="<%= about_link %>" class="landing-action landing-action-secondary ui-hover-lift">
                    <%= image_tag("task-bar/about.svg", alt: "", class: "landing-action-icon", aria: { hidden: true }) %>
                    <span>About me</span>
                </a>
            </div>
        </div>

        <aside class="landing-profile-panel" aria-label="Profile summary">
            <a href="<%= discord_link %>" target="_blank" rel="noopener noreferrer" class="landing-profile-link" title="Open Discord profile" aria-label="Open Discord profile">
                <%= image_tag("landing/profile.png", alt: "Adrian Junge profile image", class: "landing-profile-image") %>
            </a>

            <div class="landing-affiliation-links">
                <a href="<%= kitctf_link %>" target="_blank" rel="noopener noreferrer" class="landing-affiliation-link ui-hover-lift" title="Open KITCTF">
                    <%= image_tag("landing/kitctf.png", alt: "", aria: { hidden: true }) %>
                    <span>KITCTF</span>
                </a>
                <a href="<%= kit_link %>" target="_blank" rel="noopener noreferrer" class="landing-affiliation-link ui-hover-lift" title="Open KIT">
                    <%= image_tag("landing/kit.png", alt: "", aria: { hidden: true }) %>
                    <span>KIT</span>
                </a>
                <a href="<%= pgp_link %>" class="landing-affiliation-link landing-affiliation-link-pgp ui-hover-lift">
                    <%= image_tag("task-bar/pgp.svg", alt: "", aria: { hidden: true }) %>
                    <span>PGP key</span>
                </a>
            </div>
        </aside>
    </div>

    <div class="landing-metrics aboutme-stats" aria-label="Site overview links">
        <% landing_metrics.each do |metric| %>
            <a href="<%= metric[:link] %>" class="landing-metric aboutme-stat ui-hover-lift">
                <% if metric.key?(:value) %>
                    <span class="landing-metric-value aboutme-stat-value"><%= metric[:value] %></span>
                <% end %>
                <span class="landing-metric-label aboutme-stat-label"><%= metric[:label] %></span>
                <% if metric[:sublabel].present? %>
                    <span class="landing-metric-sublabel aboutme-stat-sublabel"><%= metric[:sublabel] %></span>
                <% end %>
            </a>
        <% end %>
    </div>

    <div id="scroll-down-button" class="absolute bottom-8">
        <button
            type="button"
            class="back-button ui-icon-button"
            aria-label="Scroll down"
            onclick="document.getElementById('landing-bottom').scrollIntoView({behavior:'smooth'})"
        >
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14M19 12l-7 7-7-7"/>
            </svg>
        </button>
    </div>
</section>

<section id="landing-bottom">
    <h2 class="text-3xl font-bold mb-6 text-white text-center">Latest notes</h2>

    <div class="landing-writeup-cards">
        <% @most_recent_posts.each do |post| %>
            <% if post[:type] == "blog" %>
                <% blog_config = @blogs[post[:slug]] || {} %>
                <% blog_data_with_meta = blog_config.merge({
                    "title" => post[:title],
                    "description" => post[:description],
                    "topic" => post[:topic],
                    "categories" => post[:categories],
                    "published" => post[:published].strftime("%Y-%m-%d"),
                    "reading_time_label" => post[:reading_time_label],
                    "reading_time_minutes" => post[:reading_time_minutes],
                    "logo" => blog_config["logo"]
                }) %>

                <div class="blog-post-entry">
                    <%= render_blog_post_card(post[:slug], blog_data_with_meta, interactive_tags: false) %>
                </div>
            <% elsif post[:type] == "ctf" %>
                <div class="blog-post-entry writeup-post-entry">
                    <%= render_writeup_card(post[:slug], post[:link], post[:metadata] || {}, logo: post[:logo], interactive_tags: false, show_hints: false, external_recognition_links: false) %>
                </div>
            <% end %>
        <% end %>
    </div>

</section>

</main>
