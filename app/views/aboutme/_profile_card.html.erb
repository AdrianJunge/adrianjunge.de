<% card = local_assigns.fetch(:card) %>
<% tags = Array(card[:tags]).compact %>
<% body_blocks = Array(card[:body_blocks]).compact %>
<% timeline_items = Array(card[:timeline]).compact %>
<% child_cards = Array(card[:children]).compact %>
<% collapsible = card[:collapsible] && (body_blocks.any? || timeline_items.any? || child_cards.any?) %>
<% card_url = collapsible ? nil : card[:card_url].presence %>
<% title_url = card[:title_link] ? card[:title_url].presence : nil %>
<% card_classes = [ "aboutme-card", "ui-card-surface", ("ui-hover-lift" if card_url.present?), card[:class_name], ("aboutme-card-static" unless collapsible), ("aboutme-card-linked" if card_url.present?), ("aboutme-card-nested" if card[:nested]) ].compact.join(" ") %>
<% main_classes = [ "aboutme-card-main", card[:main_class] ].compact.join(" ") %>
<% title_classes = [ "aboutme-card-title", card[:title_class] ].compact.join(" ") %>
<% tag_container_classes = [ "aboutme-card-tags", card[:tags_class] ].compact.join(" ") %>
<% summary_classes = [ "aboutme-card-summary", card[:description_class] ].compact.join(" ") %>
<% heading_tag = card[:heading_tag].presence || (card[:nested] ? :h4 : :h3) %>
<% header_content = capture do %>
  <span class="<%= main_classes %>">
    <% if card[:title].present? %>
      <% if card[:kicker].present? %>
        <span class="aboutme-card-kicker"><%= card[:kicker] %></span>
      <% end %>
      <%= content_tag(heading_tag, class: title_classes) do %>
        <%= aboutme_optional_link(card[:title], title_url, class_name: card[:title_link_class]) %>
      <% end %>
    <% end %>

    <% if tags.any? %>
      <span class="<%= tag_container_classes %>">
        <% tags.each do |tag| %>
          <%= aboutme_tag(label: tag[:label], url: tag[:url], class_name: tag[:class_name], datetime: tag[:datetime]) %>
        <% end %>
      </span>
    <% end %>

    <% if card[:description].present? %>
      <span class="<%= summary_classes %>">
        <%= aboutme_optional_link(card[:description], card[:description_url], class_name: card[:description_link_class]) %>
      </span>
    <% end %>
  </span>
<% end %>
<% body_content = capture do %>
  <% body_blocks.each do |block| %>
    <div class="aboutme-detail-block">
      <% if block[:title].present? %>
        <h3><%= block[:title] %></h3>
      <% end %>
      <% if block[:text].present? %>
        <p><%= block[:text] %></p>
      <% end %>
      <% if Array(block[:items]).any? %>
        <ul class="aboutme-card-details">
          <% Array(block[:items]).each do |item| %>
            <li><%= item %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  <% end %>

  <% if timeline_items.any? %>
    <div class="aboutme-detail-block">
      <h3><%= card[:timeline_title].presence || "Disclosure timeline" %></h3>
      <ol class="aboutme-timeline">
        <% timeline_items.each do |item| %>
          <li>
            <% if item["date"].present? %>
              <time datetime="<%= item["date"] %>"><%= item["date"] %></time>
            <% end %>
            <span><%= item["event"] %></span>
          </li>
        <% end %>
      </ol>
    </div>
  <% end %>

  <% if child_cards.any? %>
    <ol class="aboutme-card-children">
      <% child_cards.each do |child_card| %>
        <li>
          <%= render "aboutme/profile_card", card: child_card.merge(nested: true) %>
        </li>
      <% end %>
    </ol>
  <% end %>
<% end %>

<% if collapsible %>
  <details class="<%= card_classes %>" id="<%= card[:id].presence %>">
    <summary>
      <%= header_content %>
    </summary>

    <div class="aboutme-card-body">
      <%= body_content %>
    </div>
  </details>
<% else %>
  <article class="<%= card_classes %>" id="<%= card[:id].presence %>">
    <% if card_url.present? %>
      <%= link_to(card_url, aboutme_card_link_attributes(card_url, card[:aria_label].presence || card[:title].presence || "Open item")) do %>
        <span class="aboutme-card-link-label"><%= card[:aria_label].presence || card[:title].presence || "Open item" %></span>
      <% end %>
    <% end %>
    <div class="aboutme-card-header">
      <%= header_content %>
    </div>

    <% if body_blocks.any? || child_cards.any? %>
      <div class="aboutme-card-body">
        <%= body_content %>
      </div>
    <% end %>
  </article>
<% end %>
