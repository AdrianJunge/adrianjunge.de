<% title_label = entry["title"].presence || entry["short_summary"].presence || entry["summary"].presence %>
<% summary_text = aboutme_finding_summary(entry) %>
<% timeline_items = aboutme_timeline_items(entry["timeline"]) %>
<% body_blocks = [] %>
<% if aboutme_visible_detail?(summary_text) %>
  <% body_blocks << { title: "Summary", text: summary_text } %>
<% end %>
<% card_url = entry["card_url"].presence || (aboutme_finding_collapsible?(entry) ? nil : entry["title_url"].presence) %>
<% card_classes = [ "aboutme-finding-card", "aboutme-finding-card-#{kind}", ("aboutme-finding-card-static" unless aboutme_finding_collapsible?(entry)) ].compact.join(" ") %>
<% tags = [] %>
<% if entry["severity"].present? %>
  <% tags << { label: entry["severity"], class_name: "aboutme-severity #{aboutme_severity_class(entry["severity"])}" } %>
<% end %>
<% if entry["cve_id"].present? %>
  <% tags << { label: entry["cve_id"], url: aboutme_cve_url(entry["cve_id"]), class_name: "aboutme-cve-id" } %>
<% end %>
<% if entry["cwe_id"].present? %>
  <% tags << { label: entry["cwe_id"], url: aboutme_cwe_url(entry["cwe_id"]), class_name: "aboutme-cwe-id" } %>
<% end %>

<%= render "aboutme/profile_card",
           card: {
             id: entry["id"],
             class_name: card_classes,
             main_class: "aboutme-finding-main",
             title_class: "aboutme-finding-project",
             tags_class: "aboutme-finding-badges",
             description_class: "aboutme-finding-summary",
             title: entry["project"],
             title_url: entry["project_url"],
             title_link: aboutme_finding_collapsible?(entry),
             title_link_class: "aboutme-finding-project-link",
             description: title_label,
             description_url: aboutme_finding_collapsible?(entry) ? entry["title_url"] : nil,
             description_link_class: "aboutme-finding-summary-link",
             tags: tags,
             body_blocks: body_blocks,
             timeline: timeline_items,
             collapsible: aboutme_finding_collapsible?(entry),
             card_url: card_url,
             aria_label: "Open #{entry["project"].presence || title_label}"
           } %>
