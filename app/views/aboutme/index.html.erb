<% content_for :head do %>
  <% about_description = @about_info["description"].presence || "About Adrian Junge, security research, CVEs, bug bounties, certificates, and achievements." %>
  <% about_seo_items = [
       { title: "CVEs", link: about_path(anchor: "cves") },
       { title: "Bug bounties", link: about_path(anchor: "bug-bounties") },
       { title: "Created CTF challenges", link: about_path(anchor: "my-challenges") },
       { title: "Certificates", link: about_path(anchor: "certificates") },
       { title: "Talks", link: about_path(anchor: "talks") },
       { title: "Relevant achievements", link: about_path(anchor: "achievements") }
     ] %>
  <%= seo_meta_tags(
        title: "About Adrian Junge",
        description: about_description,
        type: "profile",
        canonical_path: about_path,
        image: SeoHelper::DEFAULT_IMAGE,
        json_ld: [
          seo_person_schema(description: about_description),
          seo_collection_schema(
            title: "About Adrian Junge",
            description: about_description,
            canonical_path: about_path,
            items: about_seo_items
          )
        ],
        breadcrumbs: [
          { title: "Home", link: root_path },
          { title: "About me", link: about_path }
        ]
      ) %>
<% end %>

<% about_stats = about_profile_stats %>
<% about_sections = about_profile_sections %>

<% about_stats_content = capture do %>
  <div class="aboutme-stats" aria-label="Public security work summary">
    <% about_stats.each do |stat| %>
      <a href="#<%= stat[:anchor] %>" class="aboutme-stat ui-hover-lift" aria-label="Jump to <%= stat[:label] %>">
        <span class="aboutme-stat-value"><%= stat[:value] %></span>
        <span class="aboutme-stat-label"><%= stat[:label] %></span>
      </a>
    <% end %>
  </div>
<% end %>

<main id="main-content" tabindex="-1" class="aboutme-page">
  <%= render "shared/content_hero",
             icon_path: "task-bar/about.svg",
             icon_alt: "About me",
             title: "About me",
             description_html: @about_html,
             description_class: "aboutme-copy",
             after_content: about_stats_content %>

  <% about_sections.each do |section| %>
    <%= render "section", section: section, expanded: false %>
  <% end %>
</main>
