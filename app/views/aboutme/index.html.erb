<% content_for :head do %>
  <% about_description = @about_info["description"].presence || "About Adrian Junge, security research, CVEs, bug bounties, certificates, and achievements." %>
  <% about_seo_items = [
       { title: "CVEs", link: about_path(anchor: "cves") },
       { title: "Bug bounties", link: about_path(anchor: "bug-bounties") },
       { title: "Created CTF challenges", link: about_path(anchor: "my-challenges") },
       { title: "Certificates", link: about_path(anchor: "certificates") },
       { title: "Talks", link: about_path(anchor: "talks") },
       { title: "Relevant achievements", link: about_path(anchor: "achievements") }
     ] %>
  <%= seo_meta_tags(
        title: "About Adrian Junge",
        description: about_description,
        type: "profile",
        canonical_path: about_path,
        image: "landing/profile.png",
        json_ld: [
          seo_person_schema(description: about_description),
          seo_collection_schema(
            title: "About Adrian Junge",
            description: about_description,
            canonical_path: about_path,
            items: about_seo_items
          )
        ],
        breadcrumbs: [
          { title: "Home", link: root_path },
          { title: "About me", link: about_path }
        ]
      ) %>
<% end %>

<%= render_taskbar_items %>
<%= render_terminal([], true) %>
<% about_stats = [
  { label: "CVEs", value: @cve_entry_count, anchor: "cves" },
  { label: "Bug bounties", value: @bug_bounties.length, anchor: "bug-bounties" },
  { label: "Created CTF Challenges", value: @challenges.length, anchor: "my-challenges" },
  { label: "Certificates", value: @certificates.length, anchor: "certificates" },
  { label: "Talks", value: @talks.length, anchor: "talks" },
  { label: "Achievements", value: @achievement_event_count, anchor: "achievements" }
] %>
<% about_sections = [
  {
    id: "cves",
    title: "CVEs",
    entries: @cves,
    count: @cve_entry_count,
    singular: "entry",
    plural: "entries",
    grid_class: "aboutme-finding-grid",
    partial: "aboutme/finding_card",
    card_locals: { kind: "cve" },
    empty_text: "No public CVEs are listed yet."
  },
  {
    id: "bug-bounties",
    title: "Bug bounties",
    entries: @bug_bounties,
    count: @bug_bounties.length,
    singular: "finding",
    plural: "findings",
    grid_class: "aboutme-finding-grid",
    partial: "aboutme/finding_card",
    card_locals: { kind: "bug-bounty" },
    empty_text: "No public bounties yet - the disclosure timers are still pretending to be load-bearing."
  },
  {
    id: "my-challenges",
    title: "Created CTF Challenges",
    entries: @challenges,
    count: @challenges.length,
    singular: "challenge",
    plural: "challenges",
    grid_class: "aboutme-achievement-grid",
    partial: "aboutme/milestone_card",
    empty_text: "No authored challenges are listed yet."
  },
  {
    id: "certificates",
    title: "Certificates",
    entries: @certificates,
    count: @certificates.length,
    singular: "certificate",
    plural: "certificates",
    grid_class: "aboutme-achievement-grid",
    partial: "aboutme/milestone_card",
    empty_text: "No certificates are listed yet."
  },
  {
    id: "talks",
    title: "Talks",
    entries: @talks,
    count: @talks.length,
    singular: "talk",
    plural: "talks",
    grid_class: "aboutme-achievement-grid",
    partial: "aboutme/milestone_card",
    empty_text: "No talks are listed yet."
  },
  {
    id: "achievements",
    title: "Relevant achievements",
    entries: @achievements,
    count: @achievement_event_count,
    singular: "event",
    plural: "events",
    grid_class: "aboutme-achievement-grid",
    partial: "aboutme/milestone_card",
    empty_text: "No achievements are listed yet."
  }
] %>

<% about_stats_content = capture do %>
  <div class="aboutme-stats" aria-label="Public security work summary">
    <% about_stats.each do |stat| %>
      <a href="#<%= stat[:anchor] %>" class="aboutme-stat ui-hover-lift" aria-label="Jump to <%= stat[:label] %>">
        <span class="aboutme-stat-value"><%= stat[:value] %></span>
        <span class="aboutme-stat-label"><%= stat[:label] %></span>
      </a>
    <% end %>
  </div>
<% end %>

<main class="aboutme-page">
  <%= render "shared/content_hero",
             icon_path: "task-bar/about.svg",
             icon_alt: "About me",
             title: "About me",
             description_html: @about_html,
             description_class: "aboutme-copy",
             after_content: about_stats_content %>

  <% about_sections.each do |section| %>
    <%= render "section", section: section %>
  <% end %>
</main>
