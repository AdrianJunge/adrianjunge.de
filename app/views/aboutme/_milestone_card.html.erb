<% details = aboutme_visible_details(entry["details"]) %>
<% events = aboutme_visible_events(entry["events"]) %>
<% body_blocks = [] %>
<% if details.any? %>
  <% body_blocks << { items: details } %>
<% end %>
<% tags = [] %>
<% if entry["category"].present? %>
  <% tags << { label: entry["category"], url: entry["category_url"], class_name: "aboutme-tag-#{entry["category"].parameterize}" } %>
<% end %>
<% if entry["date"].present? && events.empty? %>
  <% tags << { label: entry["date"], datetime: entry["date"], class_name: "aboutme-tag-date" } %>
<% end %>
<% child_cards = events.map do |event| %>
  <% event_details = aboutme_visible_details(event["details"]) %>
  <% event_id = event["id"].presence || [ entry["id"].presence || entry["title"], event["date"], event["title"] ].compact.join("-").parameterize %>
  <% event_body_blocks = [] %>
  <% event_body_blocks << { items: event_details } if event_details.any? %>
  <% event_tags = [] %>
  <% event_tags << { label: event["date"], datetime: event["date"], class_name: "aboutme-tag-date" } if event["date"].present? %>
  <% {
       id: event_id,
       class_name: "aboutme-achievement-event",
       title: event["title"],
       description: event["summary"],
       tags: event_tags,
       body_blocks: event_body_blocks,
       collapsible: false,
       card_url: event["card_url"].presence || event["url"].presence || entry["card_url"].presence || entry["title_url"].presence,
       aria_label: "Open #{event["title"].presence || entry["title"]}"
     } %>
<% end %>

<%= render "aboutme/profile_card",
           card: {
             id: entry["id"],
             class_name: "aboutme-achievement-card",
             tags_class: "aboutme-achievement-meta",
             title: entry["title"],
             title_link: false,
             description: entry["summary"],
             tags: tags,
             body_blocks: body_blocks,
             children: child_cards,
             collapsible: false,
             card_url: entry["card_url"].presence || entry["title_url"].presence,
             aria_label: "Open #{entry["title"]}"
           } %>
