<% content_for :head do %>
  <title>CTF organizations</title>
  <meta name="description" content="Overview of CTF competitions including links to writeups.">
  <meta property="og:title" content="CTF Overview">
  <meta property="og:description" content="Overview of CTF competitions including links to writeups.">
  <meta property="og:type" content="website">
<% end %>

<%= render_taskbar_items([
    { image_path: 'task-bar/flag.svg', alt_text: "CTF Icon", label: "CTF", link: ctf_path },
]) %>
<% terminal_paths = @ctfs.map { |name, ctf| ctf["terminal_path"] } %>
<%= render_terminal(terminal_paths, true) %>

<main class="content-page ctf-overview">
  <%= render "shared/content_hero",
             icon_path: "task-bar/flag.svg",
             icon_alt: "CTF",
             title: "CTF writeups",
             description: "Competition notes, challenge writeups, and security research practice grouped by event.",
             actions: [
               { href: "/ctf/feed", class: "ctf-rss-feed", icon_path: "task-bar/rss.svg", icon_class: "ctf-rss-icon", label: "CTF RSS feed", alt: "RSS Feed Icon" },
               { href: "/ctf/feed.atom", class: "ctf-atom-feed", icon_path: "task-bar/atom.svg", icon_class: "ctf-atom-icon", label: "CTF Atom feed", alt: "Atom Feed Icon" }
             ] %>

  <%= render "shared/content_filters",
             scope: "ctfs",
             search_id: "ctf-search-input",
             clear_id: "ctf-search-clear",
             placeholder: "Search CTFs...",
             years: @filter_years,
             tags: @filter_tags,
             total: @ctfs.length,
             input_class: "ctf-search-input" %>

  <div class="ctf-cards-container">
    <% @ctfs.each do |name, ctf| %>
      <% filter_text = [name, ctf["description"], ctf["terminal_path"]].compact.join(" ") %>
      <%= link_to ctf["writeups"],
                  class: "ctf-card",
                  data: {
                    expandable: false,
                    filter_card: "ctfs",
                    filter_text: filter_text,
                    filter_tags: Array(@ctf_tags[name]).join("|"),
                    filter_years: Array(@ctf_years[name]).join("|")
                  },
                  aria: { label: "Open #{name} writeups" } do %>
        <%= image_tag(ctf["logo"], alt: "#{name} Logo", class: "ctf-logo") %>
        <div class="ctf-details">
          <div class="ctf-text">
            <h3 class="ctf-name font-bold"><%= name %></h3>
            <p class="ctf-description"><%= ctf["description"] %></p>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
  <p class="content-filter-empty" data-filter-empty="ctfs" hidden>No CTFs match the current filters.</p>
</main>
