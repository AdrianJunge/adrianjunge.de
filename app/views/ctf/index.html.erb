<% content_for :head do %>
  <title>CTF organizations</title>
  <meta name="description" content="Overview of CTF competitions including links to writeups.">
  <meta property="og:title" content="CTF Overview">
  <meta property="og:description" content="Overview of CTF competitions including links to writeups.">
  <meta property="og:type" content="website">
<% end %>

<%= render_taskbar_items([
    { image_path: 'task-bar/flag.svg', alt_text: "CTF Icon", label: "CTF", link: ctf_path },
]) %>
<% terminal_paths = @ctfs.map { |name, ctf| ctf["terminal_path"] } %>
<%= render_terminal(terminal_paths, true) %>

<main class="content-page ctf-overview">
  <%= render "shared/content_hero",
             icon_path: "task-bar/flag.svg",
             icon_alt: "CTF",
             title: "CTF writeups",
             description: "Competition notes, challenge writeups, and security research practice grouped by event." %>

  <div class="ctf-header-section">
    <div class="ctf-header-center">
      <div class="search-wrapper relative">
        <input type="text" id="ctf-search-input" placeholder="Search CTFs..." class="ctf-search-input">
        <button type="button" class="search-clear-btn" id="ctf-search-clear" aria-label="Clear search">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <div class="ctf-header-right">
      <a href="/ctf/feed" class="ctf-rss-feed">
        <%= image_tag("task-bar/rss.svg", alt: "RSS Feed Icon", class: "ctf-rss-icon") %>
      </a>

      <a href="/ctf/feed.atom" class="ctf-atom-feed">
        <%= image_tag("task-bar/atom.svg", alt: "Atom Feed Icon", class: "ctf-atom-icon") %>
      </a>
    </div>
  </div>

  <div class="ctf-cards-container">
    <% @ctfs.each do |name, ctf| %>
      <%= link_to ctf["writeups"], class: "ctf-card", data: { expandable: false }, aria: { label: "Open #{name} writeups" } do %>
        <%= image_tag(ctf["logo"], alt: "#{name} Logo", class: "ctf-logo") %>
        <div class="ctf-details">
          <div class="ctf-text">
            <h3 class="ctf-name font-bold"><%= name %></h3>
            <p class="ctf-description"><%= ctf["description"] %></p>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</main>
