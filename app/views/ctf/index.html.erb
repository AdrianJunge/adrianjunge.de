<% content_for :head do %>
  <% ctf_description = "Capture The Flag competition events with published challenge writeups and security research notes." %>
  <% ctf_items = @ctfs.map { |name, ctf| { title: name, link: ctf["writeups"] } } %>
  <%= seo_meta_tags(
        title: "CTF events",
        description: ctf_description,
        canonical_path: ctf_path,
        image: "ctf/kitctf.png",
        json_ld: seo_collection_schema(
          title: "CTF events",
          description: ctf_description,
          canonical_path: ctf_path,
          items: ctf_items
        )
      ) %>
<% end %>

<%= render_taskbar_items %>
<% terminal_paths = @ctfs.map { |name, ctf| ctf["terminal_path"] } %>
<%= render_terminal(terminal_paths, true) %>

<main class="content-page ctf-overview">
  <%= render "shared/content_hero",
             icon_path: "task-bar/flag.svg",
             icon_alt: "CTF",
             title: "CTF events",
             description: "Capture The Flag competitions grouped by event. Open an event to browse its challenge writeups.",
             actions: feed_actions_for(:ctf, feed_url: feed_path, atom_url: feed_path(format: :atom), label: "Website") %>

  <%= render "shared/content_filters",
             scope: "ctfs",
             search_id: "ctf-search-input",
             clear_id: "ctf-search-clear",
             placeholder: "Search CTFs...",
             years: @filter_years,
             tags: @filter_tags,
             tag_groups: @filter_tag_groups,
             total: @ctfs.length %>

  <div class="ctf-cards-container">
    <% @ctfs.each do |name, ctf| %>
      <% ctf_tags = Array(@ctf_tags[name]) %>
      <% writeup_count = @ctf_writeup_counts[name].to_i %>
      <% writeup_count_label = pluralize(writeup_count, "writeup") %>
      <% ctf_card_tags = ctf_tags.map do |tag|
           {
             label: tag,
             winner: tag == WriteupWinner::FILTER_LABEL,
             authored: tag == AuthoredChallenge::FILTER_LABEL,
             difficulty_filter: WriteupDifficulty.filter_label?(tag),
             difficulty_key: tag,
             category: tag != WriteupWinner::FILTER_LABEL && tag != AuthoredChallenge::FILTER_LABEL && !WriteupDifficulty.filter_label?(tag),
             category_key: tag
           }
         end %>
      <% filter_text = [name, ctf["description"], ctf["terminal_path"], writeup_count_label, ctf_tags].flatten.compact.join(" ") %>
      <%= render_content_card(
            url: ctf["writeups"],
            class_name: "blog-post-card ctf-card",
            hitbox_class: "blog-post-card-hitbox",
            content_class: "blog-post-card-content",
            media: {
              image: ctf["logo"],
              alt: "#{name} Logo",
              image_class: "blog-logo",
              wrapper_class: "blog-post-card-logo"
            },
            body_class: "blog-post-card-details ctf-details",
            text_class: "ctf-text",
            title: name,
            title_class: "ctf-name font-bold",
            tags_outer_class: "blog-post-meta",
            tags_class: "blog-post-meta-row",
            filter_scope: "ctfs",
            tags: ctf_card_tags,
            description: ctf["description"],
            description_class: "ctf-description",
            description_tag: :p,
            date: writeup_count_label,
            date_class: "ctf-event-summary",
            date_text_class: "ctf-writeup-count-text",
            reading_time: @ctf_reading_times[name],
            reading_time_class: "ctf-total-reading-time",
            data: {
              expandable: false,
              filter_card: "ctfs",
              filter_text: filter_text,
              filter_tags: Array(@ctf_tags[name]).join("|"),
              filter_years: Array(@ctf_years[name]).join("|")
            },
            aria_label: "Open #{name} writeups"
          ) %>
    <% end %>
  </div>
  <p class="content-filter-empty" data-filter-empty="ctfs" hidden>No CTFs match the current filters.</p>
</main>
