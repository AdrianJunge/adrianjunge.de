<% content_for :head do %>
  <% ctf_description = "Competition notes, challenge writeups, and security research practice grouped by event." %>
  <%= seo_meta_tags(
        title: "CTF writeups",
        description: ctf_description,
        canonical_path: ctf_path,
        image: "ctf/kitctf.png",
        json_ld: seo_collection_schema(title: "CTF writeups", description: ctf_description, canonical_path: ctf_path)
      ) %>
<% end %>

<%= render_taskbar_items %>
<% terminal_paths = @ctfs.map { |name, ctf| ctf["terminal_path"] } %>
<%= render_terminal(terminal_paths, true) %>

<main class="content-page ctf-overview">
  <%= render "shared/content_hero",
             icon_path: "task-bar/flag.svg",
             icon_alt: "CTF",
             title: "CTF writeups",
             description: "Competition notes, challenge writeups, and security research practice grouped by event.",
             actions: feed_actions_for(:ctf, feed_url: ctf_feed_path, atom_url: ctf_feed_path(format: :atom), label: "CTF") %>

  <%= render "shared/content_filters",
             scope: "ctfs",
             search_id: "ctf-search-input",
             clear_id: "ctf-search-clear",
             placeholder: "Search CTFs...",
             years: @filter_years,
             tags: @filter_tags,
             tag_groups: @filter_tag_groups,
             total: @ctfs.length %>

  <div class="ctf-cards-container">
    <% @ctfs.each do |name, ctf| %>
      <% filter_text = [name, ctf["description"], ctf["terminal_path"]].compact.join(" ") %>
      <%= render_content_card(
            root_tag: :a,
            url: ctf["writeups"],
            class_name: "ctf-card",
            wrap_content: false,
            media: {
              image: ctf["logo"],
              alt: "#{name} Logo",
              image_class: "ctf-logo",
              wrapper_class: "ctf-card-media"
            },
            body_class: "ctf-details",
            text_class: "ctf-text",
            title: name,
            title_class: "ctf-name font-bold",
            description: ctf["description"],
            description_class: "ctf-description",
            description_tag: :p,
            data: {
              expandable: false,
              filter_card: "ctfs",
              filter_text: filter_text,
              filter_tags: Array(@ctf_tags[name]).join("|"),
              filter_years: Array(@ctf_years[name]).join("|")
            },
            aria_label: "Open #{name} writeups"
          ) %>
    <% end %>
  </div>
  <p class="content-filter-empty" data-filter-empty="ctfs" hidden>No CTFs match the current filters.</p>
</main>
