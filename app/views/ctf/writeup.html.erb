<% content_for :head do %>
  <title><%= @ctf_info["title"] %> - <%= @ctf_info['ctf'] %></title>
  <meta name="description" content="Writeup for <%= @ctf_info['title'] %> from <%= @ctf_info['year'] %> CTF.">
  <meta property="og:title" content="<%= @ctf_info['title'] %> Writeup">
  <meta property="og:description" content="Writeup for <%= @ctf_info['title'] %> from <%= @ctf_info['year'] %> CTF.">
  <meta property="og:type" content="article">
<% end %>

<%= render_taskbar_items %>
<%= render_terminal([], true) %>

<main class="content-page article-page">
<div class="writeup-wrapper relative flex items-start gap-4 mx-4">
  <div class="writeup-container bg-primary">
    <button
      type="button"
      class="collapse-toc-button toc-toggle-button writeup-toc-restore-button"
      title="Show table of contents"
      aria-label="Show table of contents"
      data-toc-toggle="toc"
      aria-expanded="true"
      aria-controls="toc"
    >
      <svg
        class="w-5 h-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round">
        <path d="M9 6l6 6-6 6"/>
      </svg>
    </button>

    <h4 class="writeup-year text-white text-center"><%= @which.upcase %>-<%= @ctf_info["year"] %></h4>
    <h1 class="writeup-title text-white text-center"><%= @ctf_info["title"] %></h1>

    <% basename = File.basename("#{@ctf_info['challengefiles']}.zip")  %>

    <% file_rel = "#{@which}/#{@ctf_info['year']}/#{@ctf_info['challengefiles']}.zip".to_s %>
    <% file_abs_path = Rails.root.join("public", "ctf", "files", file_rel) %>
    <% file_exists = "#{@ctf_info['challengefiles']}.zip".present? && File.exist?(file_abs_path) %>

    <% pdf_rel = "#{@which}/#{@ctf_info['year']}/#{@ctf_info['challengefiles']}.pdf".to_s %>
    <% pdf_abs_path = Rails.root.join("public", "ctf", "writeups", pdf_rel) %>
    <% pdf_exists = "#{@ctf_info['challengefiles']}.pdf".present? && File.exist?(pdf_abs_path) %>

    <div class="flex flex-col items-center gap-4">
      <div class="writeup-challengefiles flex items-center gap-4">
        <% if file_exists %>
          <% size = number_to_human_size(File.size(file_abs_path)) rescue nil %>
          <%= link_to ctf_file_download_path(file_rel),
                      class: "download-btn ui-article-action mt-3",
                      target: "_blank",
                      rel: "noopener",
                      aria: { label: "Download #{basename}" } do %>
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 3v12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M8 11l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M21 21H3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <%= basename %> - <%= size %>
          <% end %>
        <% end %>

        <% if pdf_exists %>
          <%= link_to "/ctf/writeups/#{pdf_rel}",
                      class: "open-pdf-btn ui-article-action mt-3",
                      target: "_blank",
                      rel: "noopener",
                      aria: { label: "PDF Writeup" } do %>
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 19a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h7l5 5v9a2 2 0 0 1-2 2H6z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M13 7V2.5L18.5 8H14a1 1 0 0 1-1-1z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            PDF Writeup
          <% end %>
        <% end %>
      </div>
    </div>

    <%= @html_content %>

    <div class="next-previous-writeups flex justify-between my-8">
      <% if @previous_writeup %>
        <a
          href="<%= @previous_writeup[:link] %>"
          class="previous-writeup-btn ui-article-action mt-3"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          <span><%= @previous_writeup[:which].upcase %> - <%= @previous_writeup[:title] %></span>
        </a>
      <% else %>
        <div></div>
      <% end %>

      <% if @next_writeup %>
        <a
          href="<%= @next_writeup[:link] %>"
          class="next-writeup-btn ui-article-action mt-3"
        >
          <span><%= @next_writeup[:which].upcase %> - <%= @next_writeup[:title] %></span>
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      <% else %>
        <div></div>
      <% end %>
    </div>
  </div>

  <div id="toc" class="table-of-content bg-primary">
    <div class="toc-header">
      <h3 class="text-slate-100 font-semibold text-3xl">Table of contents</h3>
      <button
        id="toc-toggle"
        type="button"
        class="collapse-toc-button toc-toggle-button"
        title="Collapse table of contents"
        aria-label="Collapse table of contents"
        data-toc-toggle="toc"
        aria-expanded="true"
        aria-controls="toc"
      >
        <svg
          id="toc-toggle-icon"
          class="w-5 h-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round">
          <path d="M9 6l6 6-6 6"/>
        </svg>
      </button>
    </div>
    <ul id="toc-body" class="text-slate-100">
      <% @headings.each do |heading| %>
        <% toc_depth = [[ heading[:depth].to_i, 0 ].max, 4].min %>
        <li class="toc-item toc-depth-<%= toc_depth %>" style="margin-left: <%= toc_depth * 0.85 %>rem;">
          <a href="#<%= heading[:anchor] %>" class="toc-anchor group flex items-start py-1">
            <% if toc_depth.positive? %>
              <svg width="3" height="24" viewBox="0 -9 3 24"
                class="toc-indent-marker mr-2 text-slate-400 overflow-visible group-hover:text-slate-600 dark:text-slate-600 dark:group-hover:text-slate-500">
                <path d="M0 0L3 3L0 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                </path>
              </svg>
            <% end %>
            <%= heading[:text] %>
          </a>
        </li>
      <% end %>
    </ul>
  </div>
</div>
</main>
