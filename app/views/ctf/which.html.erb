<% content_for :head do %>
  <% ctf_label = @ctf_name.presence || @ctf["terminal_path"].to_s.upcase %>
  <% ctf_title = "#{ctf_label} CTF writeups" %>
  <% ctf_description = "Writeups for the #{ctf_label} Capture The Flag competition." %>
  <% ctf_items = @ctf_info.map { |writeup, info| { title: info["title"].presence || writeup, link: "/ctf/#{@which}/#{writeup}" } } %>
  <%= seo_meta_tags(
        title: ctf_title,
        description: ctf_description,
        canonical_path: request.path,
        image: @ctf["logo"],
        json_ld: seo_collection_schema(
          title: ctf_title,
          description: ctf_description,
          canonical_path: request.path,
          items: ctf_items
        ),
        breadcrumbs: [
          { title: "Home", link: root_path },
          { title: "CTF", link: ctf_path },
          { title: ctf_label, link: request.path }
        ]
      ) %>
<% end %>

<%= render_taskbar_items %>
<%= render_terminal(@writeups, true) %>

<main class="content-page ctf-container">
  <%= render "shared/content_hero",
             icon_path: @ctf["logo"],
             icon_alt: "#{@which.upcase} logo",
             icon_class: "content-hero-logo",
             invert_icon: false,
             title: @which.upcase,
             description: "Writeups for #{@ctf["terminal_path"].upcase} challenges.",
             url: @ctf["website"],
             external: true %>

  <%= render "shared/content_filters",
             scope: "writeups",
             search_id: "writeup-search-input",
             clear_id: "writeup-search-clear",
             placeholder: "Search writeups, tags, or authors...",
             years: @filter_years,
             tags: @filter_tags,
             tag_groups: @filter_tag_groups,
             total: @ctf_info.length %>

  <div class="writeup-content" data-filter-results="writeups">
    <div class="writeup-overview">
      <% @ctf_info.each do |writeup, info| %>
        <% writeup_path = "/ctf/#{@which}/#{writeup}" %>
        <div class="blog-post-entry writeup-post-entry">
          <%= render_writeup_card(writeup, writeup_path, info) %>
        </div>
      <% end %>
    </div>
  </div>
  <p class="content-filter-empty" data-filter-empty="writeups" hidden>No writeups match the current filters.</p>
</main>
