<% content_for :head do %>
  <% blog_config = @blogs[@post_slug] || {} %>
  <% blog_description = @blog_info["description"].presence || blog_config["description"].presence || @post_slug.humanize %>
  <% blog_tags = (Array(@blog_info["categories"]) + [ @blog_category ]).map(&:to_s).reject(&:blank?).uniq %>
  <% blog_image = blog_config["logo"].presence || "blog/htb-cpts.png" %>
  <% blog_modified = @blog_info["updated"].presence || @blog_info["modified"].presence %>
  <%= seo_meta_tags(
        title: "#{@blog_title} - Blog",
        description: blog_description,
        type: "article",
        canonical_path: blog_post_path(@post_slug),
        image: SeoHelper::DEFAULT_IMAGE,
        published_time: @published_time,
        modified_time: @modified_time,
        tags: blog_tags,
        section: @blog_category,
        json_ld: seo_article_schema(
          title: @blog_title,
          description: blog_description,
          canonical_path: blog_post_path(@post_slug),
          published: @published_time,
          modified: @modified_time,
          tags: blog_tags,
          image: SeoHelper::DEFAULT_IMAGE,
          section: @blog_category
        ),
        breadcrumbs: [
          { title: "Home", link: root_path },
          { title: "Blog", link: blog_path },
          { title: @blog_title, link: blog_post_path(@post_slug) }
        ]
      ) %>
<% end %>


<%= render layout: "shared/article_shell", locals: { headings: @headings, word_total: @blog_info["word_count"], has_math: @has_math } do %>
    <p class="writeup-year text-white text-center"><%= @blog_category %></p>
    <h1 class="writeup-title text-white text-center"><%= @blog_title %></h1>
    <%= render "shared/post_meta", items: [ @blog_info["published"] ], reading_time: @blog_info["reading_time_label"] %>

    <section class="article-meta-panel blog-article-meta-panel" aria-label="Post details">
      <%= render "shared/article_description",
                 description: @blog_info["description"].presence || blog_config["description"],
                 label: "Post description" %>
    </section>

    <%= @html_content %>

    <%= render "shared/article_navigation",
               previous_item: @previous_post,
               next_item: @next_post,
               include_context: false %>
<% end %>
