<% content_for :head do %>
  <% blog_description = @blog_info["description"].presence || @post_slug.humanize %>
  <% blog_tags = (Array(@blog_info["categories"]) + [ @blog_category ]).map(&:to_s).reject(&:blank?).uniq %>
  <%= seo_meta_tags(
        title: "#{@blog_title} - Blog",
        description: blog_description,
        type: "article",
        canonical_path: blog_post_path(@post_slug),
        published_time: @published_time,
        modified_time: @modified_time,
        tags: blog_tags,
        section: @blog_category,
        authors: @article_authors,
        json_ld: seo_article_schema(
          title: @blog_title,
          description: blog_description,
          canonical_path: blog_post_path(@post_slug),
          published: @published_time,
          modified: @modified_time,
          tags: blog_tags,
          image: SeoHelper::DEFAULT_IMAGE,
          section: @blog_category,
          authors: @article_authors
        ),
        breadcrumbs: [
          { title: "Home", link: root_path },
          { title: "Blog", link: blog_path },
          { title: @blog_title, link: blog_post_path(@post_slug) }
        ]
      ) %>
<% end %>


<%= render layout: "shared/article_shell", locals: { headings: @headings, word_total: @blog_info["word_count"], has_math: @has_math } do %>
    <p class="writeup-year text-white text-center"><%= @blog_category %></p>
    <h1 class="writeup-title text-white text-center"><%= @blog_title %></h1>
    <%= render "shared/post_meta", date: @blog_info["published"], reading_time: @blog_info["reading_time_label"] %>

    <section class="article-meta-panel blog-article-meta-panel" aria-label="Post details">
      <%= render "shared/article_authors", authors: @article_authors if @blog_info["article_authors"].present? %>
      <% category_badges = render_blog_category_badges(@blog_info) %>
      <% if category_badges.any? %>
        <div class="article-meta-row article-meta-tags">
          <span class="article-meta-row-label">Tags</span>
          <div class="article-meta-row-value"><%= safe_join(category_badges) %></div>
        </div>
      <% end %>
      <% if @blog_info["slides"].present? %>
        <div class="article-meta-row writeup-article-actions">
          <span class="article-meta-row-label">Resources</span>
          <div class="article-meta-row-value writeup-challengefiles">
            <% @blog_info["slides"].each do |slide| %>
              <%= link_to slide.fetch("url"),
                          content_link_options(slide.fetch("url")).merge(
                            class: "open-pdf-btn ui-article-action",
                            target: "_blank",
                            aria: { label: "#{slide.fetch('label')} (opens in a new tab)" }
                          ) do %>
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M6 19a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h7l5 5v9a2 2 0 0 1-2 2H6z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M13 7V2.5L18.5 8H14a1 1 0 0 1-1-1z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <%= slide.fetch("label") %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
      <%= render "shared/article_description",
                 description: @blog_info["description"],
                 label: "Post description" %>
    </section>

    <%= @html_content %>

    <%= render "shared/article_navigation",
               previous_item: @previous_post,
               next_item: @next_post,
               include_context: false %>
<% end %>
