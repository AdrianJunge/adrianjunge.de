<% content_for :head do %>
  <% blog_config = @blogs[@post_slug] || {} %>
  <% blog_description = @blog_info["description"].presence || blog_config["description"].presence || @post_slug.humanize %>
  <% blog_tags = (Array(@blog_info["categories"]) + [ @blog_category ]).map(&:to_s).reject(&:blank?).uniq %>
  <% blog_image = blog_config["logo"].presence || "blog/htb-cpts.png" %>
  <% blog_modified = @blog_info["updated"].presence || @blog_info["modified"].presence %>
  <%= seo_meta_tags(
        title: "#{@blog_title} - Blog",
        description: blog_description,
        type: "article",
        canonical_path: blog_post_path(@post_slug),
        image: blog_image,
        published_time: @blog_info["published"],
        modified_time: blog_modified,
        tags: blog_tags,
        section: @blog_category,
        json_ld: seo_article_schema(
          title: @blog_title,
          description: blog_description,
          canonical_path: blog_post_path(@post_slug),
          published: @blog_info["published"],
          modified: blog_modified,
          tags: blog_tags,
          image: blog_image,
          section: @blog_category
        ),
        breadcrumbs: [
          { title: "Home", link: root_path },
          { title: "Blog", link: blog_path },
          { title: @blog_title, link: blog_post_path(@post_slug) }
        ]
      ) %>
<% end %>

<%= render_taskbar_items %>
<%= render_terminal([], true) %>

<main class="content-page article-page">
<div class="writeup-wrapper relative flex items-start gap-4 mx-4">
  <div class="writeup-container bg-primary">
    <button
      type="button"
      class="collapse-toc-button toc-toggle-button writeup-toc-restore-button"
      title="Show table of contents"
      aria-label="Show table of contents"
      data-toc-toggle="toc"
      aria-expanded="true"
      aria-controls="toc"
    >
      <svg
        class="w-5 h-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round">
        <path d="M9 6l6 6-6 6"/>
      </svg>
    </button>

    <h4 class="writeup-year text-white text-center"><%= @blog_category %></h4>
    <h1 class="writeup-title text-white text-center"><%= @blog_title %></h1>
    <%= render "shared/post_meta", items: [ @blog_info["published"] ], reading_time: @blog_info["reading_time_label"] %>

    <section class="article-meta-panel blog-article-meta-panel" aria-label="Post details">
      <%= render "shared/article_description",
                 description: @blog_info["description"].presence || blog_config["description"],
                 label: "Post description" %>
    </section>

    <%= @html_content %>
  </div>

  <div id="toc" class="table-of-content bg-primary">
    <div class="toc-header">
      <h3 class="text-slate-100 font-semibold text-3xl">Table of contents</h3>
      <button
        id="toc-toggle"
        type="button"
        class="collapse-toc-button toc-toggle-button"
        title="Collapse table of contents"
        aria-label="Collapse table of contents"
        data-toc-toggle="toc"
        aria-expanded="true"
        aria-controls="toc"
      >
        <svg
          id="toc-toggle-icon"
          class="w-5 h-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round">
          <path d="M9 6l6 6-6 6"/>
        </svg>
      </button>
    </div>
    <ul id="toc-body" class="text-slate-100">
      <% @headings.each do |heading| %>
        <% toc_depth = [[ heading[:depth].to_i, 0 ].max, 4].min %>
        <li class="toc-item toc-depth-<%= toc_depth %>" style="margin-left: <%= toc_depth * 0.85 %>rem;">
          <a href="#<%= heading[:anchor] %>" class="toc-anchor group flex items-start py-1">
            <% if toc_depth.positive? %>
              <svg width="3" height="24" viewBox="0 -9 3 24"
                class="toc-indent-marker mr-2 text-slate-400 overflow-visible group-hover:text-slate-600 dark:text-slate-600 dark:group-hover:text-slate-500">
                <path d="M0 0L3 3L0 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                </path>
              </svg>
            <% end %>
            <%= heading[:text] %>
          </a>
        </li>
      <% end %>
    </ul>
    <%= render "shared/post_progress", word_total: @blog_info["word_count"] %>
  </div>
</div>
</main>
