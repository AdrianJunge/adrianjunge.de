<% content_for :head do %>
  <title>Blog Posts</title>
  <meta name="description" content="Overview of blog posts covering various topics in cybersecurity and programming.">
  <meta property="og:title" content="Blog Overview">
  <meta property="og:description" content="Overview of blog posts covering various topics.">
  <meta property="og:type" content="website">
<% end %>

<%= render_taskbar_items([
    { image_path: 'task-bar/flag.svg', alt_text: "Blog Icon", label: "Blog", link: blog_path },
]) %>
<% terminal_paths = @blog_posts.map { |post| post[:slug] } %>
<%= render_terminal(terminal_paths, true) %>

<main class="content-page blog-overview">
  <%= render "shared/content_hero",
             icon_path: "task-bar/blog.svg",
             icon_alt: "Blog",
             title: "Blog",
             description: "Longer notes on security work, learning, and practical writeups outside the CTF archive." %>

  <div class="blog-header-section">
    <div class="blog-header-center">
      <div class="search-wrapper relative">
        <input type="text" id="blog-search-input" placeholder="Search Blog Posts..." class="blog-search-input">
        <button type="button" class="search-clear-btn" id="blog-search-clear" aria-label="Clear search">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <div class="blog-header-right">
      <a href="/blog/feed" class="blog-rss-feed">
        <%= image_tag("task-bar/rss.svg", alt: "RSS Feed Icon", class: "blog-rss-icon") %>
      </a>

      <a href="/blog/feed.atom" class="blog-atom-feed">
        <%= image_tag("task-bar/atom.svg", alt: "Atom Feed Icon", class: "blog-atom-icon") %>
      </a>
    </div>
  </div>

  <div class="blog-posts-container">
    <% @blog_posts.each do |post| %>
      <div class="blog-post-entry">
        <% blog_data = @blogs[post[:slug]] || {} %>
        <% blog_data_with_meta = blog_data.merge({
          "title" => post[:title],
          "description" => post[:description],
          "topic" => post[:topic],
          "categories" => post[:categories],
          "published" => post[:published].strftime("%Y-%m-%d"),
          "logo" => blog_data["logo"]
        }) %>
        <%= render_blog_post_card(post[:slug], blog_data_with_meta, @blogs) %>
      </div>
    <% end %>
  </div>
</main>
