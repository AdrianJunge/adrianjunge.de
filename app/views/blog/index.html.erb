<% content_for :head do %>
  <title>Blog Posts</title>
  <meta name="description" content="Overview of blog posts covering various topics in cybersecurity and programming.">
  <meta property="og:title" content="Blog Overview">
  <meta property="og:description" content="Overview of blog posts covering various topics.">
  <meta property="og:type" content="website">
<% end %>

<%= render_taskbar_items %>
<% terminal_paths = @blog_posts.map { |post| post[:slug] } %>
<%= render_terminal(terminal_paths, true) %>

<main class="content-page blog-overview">
  <%= render "shared/content_hero",
             icon_path: "task-bar/blog.svg",
             icon_alt: "Blog",
             title: "Blog",
             description: "Longer notes on security work, learning, and practical writeups outside the CTF archive.",
             actions: feed_actions_for(:blog, feed_url: blog_feed_path, atom_url: blog_feed_path(format: :atom), label: "Blog") %>

  <%= render "shared/content_filters",
             scope: "blogs",
             search_id: "blog-search-input",
             clear_id: "blog-search-clear",
             placeholder: "Search blog posts...",
             years: @filter_years,
             tags: @filter_tags,
             total: @blog_posts.length,
             input_class: "blog-search-input" %>

  <div class="blog-posts-container">
    <% @blog_posts.each do |post| %>
      <div class="blog-post-entry">
        <% blog_data = @blogs[post[:slug]] || {} %>
        <% blog_data_with_meta = blog_data.merge({
          "title" => post[:title],
          "description" => post[:description],
          "topic" => post[:topic],
          "categories" => post[:categories],
          "published" => post[:published].strftime("%Y-%m-%d"),
          "logo" => blog_data["logo"]
        }) %>
        <%= render_blog_post_card(post[:slug], blog_data_with_meta) %>
      </div>
    <% end %>
  </div>
  <p class="content-filter-empty" data-filter-empty="blogs" hidden>No blog posts match the current filters.</p>
</main>
