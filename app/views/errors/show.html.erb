<% content_for :head do %>
  <%= seo_meta_tags(
        title: "#{@status_code} #{@error_content[:title]}",
        description: @error_content[:summary],
        noindex: true
      ) %>
<% end %>


<main id="main-content" tabindex="-1" class="content-page error-page">
  <%= render "shared/content_hero",
             icon_path: "task-bar/error.svg",
             icon_alt: "Error",
             title: "#{@status_code} #{@error_content[:title]}",
             description: @error_content[:summary] %>

  <section class="error-panel" aria-label="Error details">
    <p><%= @error_content[:detail] %></p>

    <div class="error-actions">
      <%= link_to "Home", root_path, class: "content-link-button ui-hover-lift" %>
      <%= link_to "Timeline", timeline_path, class: "content-link-button ui-hover-lift" %>
    </div>
  </section>
</main>
