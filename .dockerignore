# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*
/.venv*
**/__pycache__

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Exclude legacy local databases retained from earlier checkouts.
/storage/*
/tmp/storage/*

# Ignore assets.
**/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore CI service files.
/.github

# Ignore Docker-related files
/.dockerignore
/Dockerfile*

# Keep the runtime focused on the site and its published content.
/test
/scripts
/notes.md
/README.md
/.overcommit.yml
/.rubocop.yml
/package*.json
/content/images
/bin/setup
/bin/update
/bin/dev
/bin/rubocop
/bin/brakeman
/bin/production-check
/bin/check
/playwright.config.mjs
/playwright.mobile.config.mjs
